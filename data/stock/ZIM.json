ood and delicate electronics. As of December 31, 2025, it operated a fleet of 128 vessels, such as 115 container vessels and 13 vehicle transport vessels, as well as a network of 56 weekly lines. ZIM Integrated Shipping Services Ltd. was incorporated in 1945 and is headquartered in Haifa, Israel.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"4412","sic_desc":"Deep Sea Foreign Transportation of  Freight","sector":"Industrials","industry":"Marine Shipping","mcap":3517969152,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"HAIFA","exchange":"XNYS","fy_end":"1231","cik":1654126,"state_inc":"L3","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"Yahoo quarterly income statement via yfinance (third-party fallback)","asof":"2026-10-03","q":[{"end":"2025-06-30","rev":1635700000.0,"rev_yoy":null,"eps":0.19,"eps_yoy":null,"ni":22800000.0,"ni_yoy":null,"nm":1.4,"derived":null,"fp":null},{"end":"2025-09-30","rev":1777200000.0,"rev_yoy":null,"eps":1.02,"eps_yoy":null,"ni":123000000.0,"ni_yoy":null,"nm":6.9,"derived":null,"fp":null},{"end":"2025-12-31","rev":1484700000.0,"rev_yoy":null,"eps":0.32,"eps_yoy":null,"ni":38100000.0,"ni_yoy":null,"nm":2.6,"derived":null,"fp":null},{"end":"2026-03-31","rev":1396500000.0,"rev_yoy":null,"eps":-0.71,"eps_yoy":null,"ni":-86000000.0,"ni_yoy":null,"nm":-6.2,"derived":null,"fp":null},{"end":"2026-06-30","rev":1780700000.0,"rev_yoy":8.9,"eps":0.53,"eps_yoy":178.9,"ni":63500000.0,"ni_yoy":178.5,"nm":3.6,"derived":null,"fp":null}],"a":[{"end":"2020-12-31","rev":3991700000.0,"rev_yoy":null,"eps":4.96,"eps_yoy":null,"ni":524200000.0,"nm":13.1},{"end":"2021-12-31","rev":10728700000.0,"rev_yoy":168.78,"eps":39.02,"eps_yoy":686.69,"ni":4649100000.0,"nm":43.3},{"end":"2022-12-31","rev":12561600000.0,"rev_yoy":17.08,"eps":38.35,"eps_yoy":-1.72,"ni":4629000000.0,"nm":36.9},{"end":"2023-12-31","rev":5162200000.