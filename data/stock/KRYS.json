,"biz":{"name":"Krystal Biotech, Inc. Common Stock","desc":"Krystal Biotech Inc is an integrated, commercial-stage biotechnology company focused on the discovery, development, manufacturing, and commercialization of genetic medicines to treat diseases with high unmet medical needs. The company uses its patented HSV-1-based gene therapy platform to create vectors that deliver therapeutic transgenes to target cells. It possesses exclusive rights to develop, manufacture, and commercialize VYJUVEK internationally. The company operates as one operating segment focused on pharmaceutical products and manufactures, markets, and sells VYJUVEK in the United States and markets and sells VYJUVEK in the European Union, and Japan.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"2836","sic_desc":"Biological Products, (No Diagnostic Substances)","sector":"Healthcare","industry":"Biotechnology","mcap":9628797339.16,"mcap_src":"Massive ticker details (2026-10-03)","shares":29598836,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"PITTSBURGH, PA","website":"https://www.krystalbio.com","employees":295,"list_date":"2017-09-20","exchange":"XNAS","fy_end":"1231","cik":1711279,"massive_asof":"2026-10-03","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-06","q":[{"end":"2023-09-30","rev":8556000.0,"rev_yoy":null,"eps":2.79,"eps_yoy":"turned +","ni":80747000.0,"ni_yoy":"turned +","nm":943.7,"derived":null,"fp":null},{"end":"2023-12-31","rev":42143000.0,"rev_yoy":null,"eps":0.31,"eps_yoy":"turned +","ni":8692000.0,"ni_yoy":"turned +","nm":20.6,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":45250000.0,"rev_yoy":null,"eps":0.03,"eps_yoy":"turned +","ni":932000.0,"ni_yoy":"turned +","nm":2.1,"derived":null,"fp":null},{"end":"2024-06-30","rev":70284000.0,"rev_yoy":null,"eps":0.53,"eps_yoy":"turned +","ni":15568000.0,"ni_yoy":"turned +","nm":22.2,"derived":null,"fp":null},{"end":"20