group_rank":18,"group_n":238,"sector_rank":26,"sector_n":375,"earn":10}},"biz":{"name":"Replimune Group, Inc.","desc":"Replimune Group Inc is a clinical-stage biotechnology company committed to applying its expertise in the field of oncolytic immunotherapy to transform the lives of cancer patients through novel oncolytic immunotherapies. Its proprietary oncolytic immunotherapy product candidates are designed and intended to maximally activate the immune system against cancer. Oncolytic immunotherapy is an emerging drug class. The proprietary RPx platform is based on a novel, engineered strain of herpes simplex virus 1, or HSV-1, backbone with payloads added that are intended to maximize immunogenic cell death and the induction of a systemic anti-tumor immune response. It operates in single segment of developing oncolytic immunotherapies for the treatment of cancer.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"2836","sic_desc":"Biological Products, (No Diagnostic Substances)","sector":"Healthcare","industry":"Biotechnology","mcap":1267254077.3,"mcap_src":"Massive ticker details (2026-10-03)","shares":93798096,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"WOBURN, MA","website":"https://www.replimune.com","employees":465,"list_date":"2018-07-20","exchange":"XNAS","fy_end":"0331","cik":1737953,"state_inc":"DE","massive_asof":"2026-10-03","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-06","q":[{"end":"2023-09-30","rev":null,"rev_yoy":null,"eps":-0.9,"eps_yoy":-13.9,"ni":-60044000.0,"ni_yoy":-39.3,"nm":null,"derived":null,"fp":null},{"end":"2023-12-31","rev":null,"rev_yoy":null,"eps":-0.77,"eps_yoy":-11.6,"ni":-51120000.0,"ni_yoy":-28.8,"nm":null,"derived":null,"fp":null},{"end":"2024-03-31","rev":null,"rev_yoy":null,"eps":-0.82,"eps_yoy":-10.8,"ni":-55081000.0,"ni_yoy":-11.9,"nm":null,"derived":["eps","ni"],"fp":null},{"end":"2024-06-30","rev":null,"rev_yoy":null,"ep