ical Solutions segment offers technical, manufacturing, engineering, and operations services to public and private sector customers. The company was formerly known as USEC Inc. and changed its name to Centrus Energy Corp. in September 2014. Centrus Energy Corp. was incorporated in 1998 and is headquartered in Bethesda, Maryland.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"1400","sic_desc":"Mining & Quarrying of  Nonmetallic Minerals (No Fuels)","sector":"Energy","industry":"Uranium","mcap":2848504320,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"BETHESDA, MD","exchange":"XNYS","fy_end":"1231","cik":1065059,"state_inc":"DE","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-03","q":[{"end":"2023-09-30","rev":51300000.0,"rev_yoy":54.5,"eps":0.52,"eps_yoy":"turned +","ni":8200000.0,"ni_yoy":"turned +","nm":16.0,"derived":null,"fp":null},{"end":"2023-12-31","rev":103600000.0,"rev_yoy":-17.9,"eps":3.62,"eps_yoy":174.2,"ni":55900000.0,"ni_yoy":164.9,"nm":54.0,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":43700000.0,"rev_yoy":-34.7,"eps":-0.38,"eps_yoy":-180.9,"ni":-6100000.0,"ni_yoy":-184.7,"nm":-14.0,"derived":null,"fp":null},{"end":"2024-06-30","rev":189000000.0,"rev_yoy":92.1,"eps":1.89,"eps_yoy":127.7,"ni":30600000.0,"ni_yoy":140.9,"nm":16.2,"derived":null,"fp":null},{"end":"2024-09-30","rev":57700000.0,"rev_yoy":12.5,"eps":-0.3,"eps_yoy":-157.7,"ni":-5000000.0,"ni_yoy":-161.0,"nm":-8.7,"derived":null,"fp":null},{"end":"2024-12-31","rev":151600000.0,"rev_yoy":46.3,"eps":3.27,"eps_yoy":-9.7,"ni":52500000.0,"ni_yoy":-6.1,"nm":34.6,"derived":["eps","rev","ni"],"fp":null},{"end":"2025-03-31","rev":73100000.0,"rev_yoy":67.3,"eps":1.6,"eps_yoy":"turned +","ni":27200000.0,"ni_yoy":"turned +","nm":37.2,"derived":null,"fp":null},{"end":"2025-06-30","rev":154500000