"biz":{"name":"Apimeds Pharmaceuticals US, Inc.","desc":"Apimeds Pharmaceuticals Us Inc is a development-stage biopharmaceutical company. The Company operates its biopharmaceutical business. Its primary focus is the clinical development of Apitox, a purified honeybee venom-based drug candidate being evaluated for the treatment of pain and inflammation associated with knee osteoarthritis. The Company operates in two segments: the biopharmaceutical segment, which is focused on the clinical development of Apitox through Lokahi, and the digital asset operations segment, which encompasses the holding, sale, and advancement of the MindWaveDAO blockchain and related digital assets through MindWave.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"2834","sic_desc":"Pharmaceutical Preparations","sector":"Healthcare","industry":"Drug Manufacturers - Specialty & Generic","mcap":10760011.34,"mcap_src":"Massive ticker details (2026-10-08)","shares":1509118,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"MATAWAN, NJ","website":"https://www.apimedsus.com","employees":7,"list_date":"2025-05-09","exchange":"XASE","fy_end":"1231","cik":1894525,"state_inc":"DE","massive_asof":"2026-10-08","sec_asof":"2026-10-10"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-07","q":[{"end":"2024-03-31","rev":null,"rev_yoy":null,"eps":-0.04,"eps_yoy":null,"ni":-296473.0,"ni_yoy":null,"nm":null,"derived":null,"fp":null},{"end":"2024-06-30","rev":null,"rev_yoy":null,"eps":-0.06,"eps_yoy":null,"ni":-449363.0,"ni_yoy":null,"nm":null,"derived":null,"fp":null},{"end":"2024-09-30","rev":null,"rev_yoy":null,"eps":-0.04,"eps_yoy":null,"ni":-332521.0,"ni_yoy":null,"nm":null,"derived":null,"fp":null},{"end":"2024-12-31","rev":null,"rev_yoy":null,"eps":-0.04,"eps_yoy":null,"ni":-311633.0,"ni_yoy":null,"nm":null,"derived":["eps","ni"],"fp":null},{"end":"2025-03-31","rev":null,"rev_yoy":null,"eps":-0.05,"eps_yoy":-25.0,"ni":-402397.0,"ni_yo