earn":57}},"biz":{"name":"Vir Biotechnology, Inc. Common Stock","desc":"Vir Biotechnology Inc is a clinical-stage biopharmaceutical company focused on powering the immune system by discovering and developing medicines for serious infectious diseases and cancer. The company uses its capabilities in antibody discovery and engineering, coupled with its proprietary AI engine dAIsY system, and the PRO-XTEN masking platform, to quickly and effectively discover and optimize potential new medicines. Its clinical development pipeline consists of investigational therapies like Tobevibart + elebsiran targeting the hepatitis delta virus (HDV), preclinical antibody candidates targeting HIV, and VIR-5500, VIR-5818, VIR-5525, and 7 PRO-XTEN programs targeting multiple solid tumors. Currently, the company generates revenue mainly by issuing license rights and through grants.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"2836","sic_desc":"Biological Products, (No Diagnostic Substances)","sector":"Healthcare","industry":"Biotechnology","mcap":1890142250.86,"mcap_src":"Massive ticker details (2026-10-06)","shares":169215958,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"SAN FRANCISCO, CA","website":"https://www.vir.bio","employees":367,"list_date":"2019-10-11","exchange":"XNAS","fy_end":"1231","cik":1706431,"state_inc":"DE","massive_asof":"2026-10-06","sec_asof":"2026-10-07"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-03","q":[{"end":"2023-09-30","rev":2639000.0,"rev_yoy":-99.3,"eps":-1.22,"eps_yoy":-193.8,"ni":-163413000.0,"ni_yoy":-193.2,"nm":-6192.2,"derived":null,"fp":null},{"end":"2023-12-31","rev":16787000.0,"rev_yoy":-66.0,"eps":-0.86,"eps_yoy":-14.7,"ni":-116029000.0,"ni_yoy":-14.2,"nm":-691.2,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":56376000.0,"rev_yoy":-10.5,"eps":-0.48,"eps_yoy":54.7,"ni":-65276000.0,"ni_yoy":53.7,"nm":-115.8,"derived":null,"fp":null},{"end":"2024-06-