group_n":389,"sector_rank":178,"sector_n":258,"earn":44}},"biz":{"name":"G-Iii Apparel Group Ltd","desc":"G-III Apparel Group Ltd is an apparel manufacturing company. The company makes a wide range of apparel, footwear, and accessories that sells under its own brands, licensed brands, and private-label brands. It has a substantial portfolio for licensed and proprietary brands, anchored by brands: DKNY, Donna Karan, Karl Lagerfeld, Karl Lagerfeld Paris, Vilebrequin, and others. The reportable segments of the company are Wholesale Operations and Retail Operations. The Wholesale operations segment includes sales of products under brands licensed by from third parties, and sales of products under its own brands and private label brands. The retail operations segment consists of Wilsons Leather, G.H. Bass, and DKNY retail stores. It derives majority of its revenue from Wholesale operations.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"2300","sic_desc":"Apparel & Other Finishd Prods of  Fabrics & Similar Matl","sector":"Consumer Cyclical","industry":"Apparel Manufacturing","mcap":1182105325.56,"mcap_src":"Massive ticker details (2026-10-03)","shares":42876508,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"NEW YORK, NY","website":"https://www.giii.com","employees":4500,"list_date":"1989-12-14","exchange":"XNAS","fy_end":"0131","cik":821002,"state_inc":"DE","massive_asof":"2026-10-03","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-06","q":[{"end":"2023-10-31","rev":1067110000.0,"rev_yoy":-1.0,"eps":2.74,"eps_yoy":117.5,"ni":127640000.0,"ni_yoy":108.9,"nm":12.0,"derived":null,"fp":null},{"end":"2024-01-31","rev":764782000.0,"rev_yoy":-10.5,"eps":0.62,"eps_yoy":"turned +","ni":-147139260.0,"ni_yoy":-14.8,"nm":-19.2,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-04-30","rev":609747000.0,"rev_yoy":0.5,"eps":0.12,"eps_yoy":71.4,"ni":5802000.0,"ni_yoy":79.3,"nm":1.0,"der