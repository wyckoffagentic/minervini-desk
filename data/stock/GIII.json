as BCBG, Calvin Klein, Champion, Cole Haan, Converse, Dockers, French Connection, Halston, Kenneth Cole, Kensie, Levi's, Margaritaville, Nautica, Tommy Hilfiger, and Vince Camuto. The company also engages in licensed team sports business that has partnerships with the National Football League, National Basketball Association, Major League Baseball, and National Hockey League, as well as U.S. colleges and universities. It distributes its products through retailers, digital channels, and online retail partners. G-III Apparel Group, Ltd. was founded in 1956 and is based in New York, New York.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"2300","sic_desc":"Apparel & Other Finishd Prods of  Fabrics & Similar Matl","sector":"Consumer Cyclical","industry":"Apparel Manufacturing","mcap":1163239680,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"NEW YORK, NY","exchange":"XNAS","fy_end":"0131","cik":821002,"state_inc":"DE","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-09-29","q":[{"end":"2023-10-31","rev":1067110000.0,"rev_yoy":-1.0,"eps":2.74,"eps_yoy":117.5,"ni":127640000.0,"ni_yoy":108.9,"nm":12.0,"derived":null,"fp":null},{"end":"2024-01-31","rev":764782000.0,"rev_yoy":-10.5,"eps":0.62,"eps_yoy":"turned +","ni":-147139260.0,"ni_yoy":-14.8,"nm":-19.2,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-04-30","rev":609747000.0,"rev_yoy":0.5,"eps":0.12,"eps_yoy":71.4,"ni":5802000.0,"ni_yoy":79.3,"nm":1.0,"derived":null,"fp":null},{"end":"2024-07-31","rev":644755000.0,"rev_yoy":-2.3,"eps":0.53,"eps_yoy":51.4,"ni":24212000.0,"ni_yoy":47.3,"nm":3.8,"derived":null,"fp":null},{"end":"2024-10-31","rev":1086759000.0,"rev_yoy":1.8,"eps":2.55,"eps_yoy":-6.9,"ni":114768000.0,"ni_yoy":-10.1,"nm":10.6,"derived":null,"fp":null},{"end":"2025-01-31","rev":839535000.0,"rev_yoy":9.8,"eps":1.03,"eps_