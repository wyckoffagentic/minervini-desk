ces to consumers and businesses, which includes retail banking, commercial lending, agricultural lending, retail and correspondent residential mortgage banking, and small business administration lending. Merchants Bancorp was founded in 1990 and is headquartered in Carmel, Indiana.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"6022","sic_desc":"State Commercial Banks","sector":"Financial Services","industry":"Banks - Regional","mcap":2368107776,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"CARMEL, IN","exchange":"XNAS","fy_end":"1231","cik":1629019,"state_inc":"IN","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-09-29","q":[{"end":"2023-09-30","rev":296676000.0,"rev_yoy":121.2,"eps":1.68,"eps_yoy":37.7,"ni":81504000.0,"ni_yoy":39.4,"nm":27.5,"derived":null,"fp":null},{"end":"2023-12-31","rev":311759000.0,"rev_yoy":71.8,"eps":1.58,"eps_yoy":41.1,"ni":77473000.0,"ni_yoy":35.5,"nm":24.9,"derived":null,"fp":null},{"end":"2024-03-31","rev":314173000.0,"rev_yoy":48.7,"eps":1.8,"eps_yoy":68.2,"ni":87054000.0,"ni_yoy":58.4,"nm":27.7,"derived":null,"fp":null},{"end":"2024-06-30","rev":328273000.0,"rev_yoy":27.2,"eps":1.49,"eps_yoy":13.7,"ni":76393000.0,"ni_yoy":17.0,"nm":23.3,"derived":null,"fp":null},{"end":"2024-09-30","rev":338928000.0,"rev_yoy":14.2,"eps":1.17,"eps_yoy":-30.4,"ni":61273000.0,"ni_yoy":-24.8,"nm":18.1,"derived":null,"fp":null},{"end":"2024-12-31","rev":321346000.0,"rev_yoy":3.1,"eps":1.85,"eps_yoy":17.1,"ni":95666000.0,"ni_yoy":23.5,"nm":29.8,"derived":["eps","rev","ni"],"fp":null},{"end":"2025-03-31","rev":287204000.0,"rev_yoy":-8.6,"eps":0.93,"eps_yoy":-48.3,"ni":58239000.0,"ni_yoy":-33.1,"nm":20.3,"derived":null,"fp":null},{"end":"2025-06-30","rev":304399000.0,"rev_yoy":-7.3,"eps":0.6,"eps_yoy":-59.7,"ni":37981000.0,"ni_yoy":-50.3,"nm":12.5,"derived":null,"fp":n