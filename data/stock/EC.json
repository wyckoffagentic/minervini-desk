oney not selling (moderate significance); last 5 bars: up bars on heavier volume (1.4x vs 0.9x) = demand in control; latest: no supply 30 Sep on 0.7x volume, closed on the low - no selling pressure inside an uptrend: significant, at support / new lows (moderate significance); balance strength 66/100.","status":"confirmed","last_sign":{"name":"No supply","d":"2026-09-30","pol":1,"sig":0.78,"tier":"moderate","why":"no selling pressure inside an uptrend: significant","ref":null},"key_bars":[{"name":"No supply","d":"2026-08-28","pol":1,"sig":1.27,"tier":"moderate"},{"name":"Effort to rise","d":"2026-09-01","pol":1,"sig":0.83,"tier":"moderate"},{"name":"No supply","d":"2026-09-30","pol":1,"sig":0.78,"tier":"moderate"}],"asof":null},"scores":{"overall":69,"group":"SIC 131x (Oil & Gas Extraction)","group_rank":12,"group_n":52,"sector_rank":26,"sector_n":126,"earn":73}},"biz":{"name":"ECOPETROL S.A.","desc":"Ecopetrol S.A. operates as an integrated energy company. It operates through four segments: Exploration and Production; Transport and Logistics; Refining and Petrochemicals; and Energy transmission and Toll Roads Concessions. The Exploration and Production segment engages in the exploration and production of oil and gas. The Transport and Logistics segment is involved in the transportation of crude oil, motor fuels, fuel oil, and other refined products, including diesel, jet, and biofuels. The Refining and Petrochemicals segment refines and processes crude oil at the Barrancabermeja and Cartagena refineries; and distributes natural gas and LPG. The energy Transmission and Toll Roads Concessions segment supplies transmission and information technology and telecommunications services, as well as designs, develops, constructs, operates, and maintains road and energy infrastructure projects. The company operates in Colombia, the United States, China, Brazil, India, Singapore and other Asian countries, Peru, Chile, Other South America countries, Central America and the Caribbean, and Europe. The company was formerly known as Empresa Colombiana de Petróleos and changed its name to Ecopetrol S.A. in June 2003. Ecopetrol S.A. was incorporated in 1948 and is based in Bogotá, Colombia.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"1311","sic_desc":"Crude Petroleum & Natural Gas","sector":"Energy","industry":"Oil & Gas Integrated","mcap":34332442624,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"BOGOTA","exchange":"XNYS","fy_end":"1231","cik":1444406,"state_inc":"F8","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"Yahoo quarterly income statement via yfinance (third-party fallback)","asof":"2026-10-03","q":[{"end":"2025-03-31","rev":null,"rev_yoy":null,"eps":null,"eps_yoy":null,"ni":null,"ni_yoy":null,"nm":null,"derived":null,"fp":null},{"end":"2025-06-30","rev":29669000000000.0,"rev_yoy":null,"eps":882.0,"eps_yoy":null,"ni":1811000000000.0,"ni_yoy":null,"nm":6.1,"derived":null,"fp":null},{"end":"2025-09-30","rev":29840000000000.0,"rev_yoy":null,"eps":1246.695542,"eps_yoy":null,"ni":2563000000000.0,"ni_yoy":null,"nm":8.6,"derived":null,"fp":null},{"end":"2025-12-31","rev":28819000000000.0,"rev_yoy":null,"eps":742.763985,"eps_yoy":null,"ni":2986000000000.0,"ni_yoy":null,"nm":10.4,"derived":null,"fp":null},{"end":"2026-03-31","rev":28625000000000.0,"rev_yoy":null,"eps":1404.295759,"eps_yoy":null,"ni":2887000000000.0,"ni_yoy":null,"nm":10.1,"derived":null,"fp":null},{"end":"2026-06-30","rev":40198000000000.0,"rev_yoy":35.5,"eps":2950.0,"eps_yoy":234.5,"ni":6064000000000.0,"ni_yoy":234.8,"nm":15.1,"derived":null,"fp":null}],"a":[{"end":"2019-12-31","rev":71488512000000.0,"rev_yoy":null,"eps":334.27,"eps_yoy":null,"ni":15005155000000.0,"nm":21.0},{"end":"2020-12-31","rev":50223393000000.0,"rev_yoy":-29.75,"eps":38.59,"eps_yoy":-88.46,"ni":2737853000000.0,"nm":5.5},{"end":"2021-12-31","rev":9188120