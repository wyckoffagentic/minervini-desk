onveying equipment; individual components and equipment for baling recyclable and waste materials; and fiber-based products. It sells its products and services through direct sales, independent sales agents, and distributors. The company was formerly known as Thermo Fibertek, Inc. and changed its name to Kadant Inc. in July 2001. Kadant Inc. was incorporated in 1991 and is headquartered in Westford, Massachusetts.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"3550","sic_desc":"Special Industry Machinery (No Metalworking Machinery)","sector":"Industrials","industry":"Specialty Industrial Machinery","mcap":3154569472,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"WESTFORD, MA","exchange":"XNYS","fy_end":"0102","cik":886346,"state_inc":"DE","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-09-30","q":[{"end":"2023-09-30","rev":244182000.0,"rev_yoy":8.8,"eps":2.63,"eps_yoy":11.9,"ni":30864000.0,"ni_yoy":12.3,"nm":12.6,"derived":null,"fp":null},{"end":"2023-12-30","rev":238679000.0,"rev_yoy":2.8,"eps":2.33,"eps_yoy":4.5,"ni":27396000.0,"ni_yoy":5.1,"nm":11.5,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-30","rev":248975000.0,"rev_yoy":8.4,"eps":2.1,"eps_yoy":-12.5,"ni":24689000.0,"ni_yoy":-12.1,"nm":9.9,"derived":null,"fp":null},{"end":"2024-06-29","rev":274765000.0,"rev_yoy":12.1,"eps":2.66,"eps_yoy":4.7,"ni":31291000.0,"ni_yoy":5.2,"nm":11.4,"derived":null,"fp":null},{"end":"2024-09-28","rev":271614000.0,"rev_yoy":11.2,"eps":2.68,"eps_yoy":1.9,"ni":31586000.0,"ni_yoy":2.3,"nm":11.6,"derived":null,"fp":null},{"end":"2024-12-28","rev":258030000.0,"rev_yoy":8.1,"eps":2.04,"eps_yoy":-12.4,"ni":24032000.0,"ni_yoy":-12.3,"nm":9.3,"derived":["eps","rev","ni"],"fp":null},{"end":"2025-03-29","rev":239210000.0,"rev_yoy":-3.9,"eps":2.04,"eps_yoy":-2.9,"ni":24063000.0,"ni_yoy":-2.5,