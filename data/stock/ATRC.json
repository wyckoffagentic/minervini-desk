 solutions are used by physicians to freeze nerves during cardiothoracic or thoracic surgical procedures.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"3841","sic_desc":"Surgical & Medical Instruments & Apparatus","sector":"Healthcare","industry":"Medical Instruments & Supplies","mcap":2725924695.46,"mcap_src":"Massive ticker details (2026-10-03)","shares":50866294,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"MASON, OH","website":"https://www.atricure.com","employees":1350,"list_date":"2005-08-05","exchange":"XNAS","fy_end":"1231","cik":1323885,"state_inc":"DE","massive_asof":"2026-10-03","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-09-28","q":[{"end":"2023-09-30","rev":98290000.0,"rev_yoy":18.1,"eps":-0.2,"eps_yoy":25.9,"ni":-9055000.0,"ni_yoy":26.2,"nm":-9.2,"derived":null,"fp":null},{"end":"2023-12-31","rev":106543000.0,"rev_yoy":21.0,"eps":-0.21,"eps_yoy":-133.3,"ni":-9789000.0,"ni_yoy":-134.7,"nm":-9.2,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":108851000.0,"rev_yoy":16.4,"eps":-0.28,"eps_yoy":-100.0,"ni":-13269000.0,"ni_yoy":-104.9,"nm":-12.2,"derived":null,"fp":null},{"end":"2024-06-30","rev":116269000.0,"rev_yoy":15.2,"eps":-0.17,"eps_yoy":-54.5,"ni":-8008000.0,"ni_yoy":-56.5,"nm":-6.9,"derived":null,"fp":null},{"end":"2024-09-30","rev":115910000.0,"rev_yoy":17.9,"eps":-0.17,"eps_yoy":15.0,"ni":-7853000.0,"ni_yoy":13.3,"nm":-6.8,"derived":null,"fp":null},{"end":"2024-12-31","rev":124277000.0,"rev_yoy":16.6,"eps":-0.33,"eps_yoy":-57.1,"ni":-15568000.0,"ni_yoy":-59.0,"nm":-12.5,"derived":["eps","rev","ni"],"fp":null},{"end":"2025-03-31","rev":123620000.0,"rev_yoy":13.6,"eps":-0.14,"eps_yoy":50.0,"ni":-6747000.0,"ni_yoy":49.2,"nm":-5.5,"derived":null,"fp":null},{"end":"2025-06-30","rev":136139000.0,"rev_yoy":17.1,"eps":-0.13,"eps_yoy":23.5,"ni":-6190000.0,"ni_yoy":22.7,"nm":-4.5,"derived":null,"fp":null},{"end":"2025-09-30","rev":134269