lden, Colorado.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"2082","sic_desc":"Malt Beverages","sector":"Consumer Defensive","industry":"Beverages - Brewers","mcap":6809297920,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"GOLDEN, CO","exchange":"XNYS","fy_end":"1231","cik":24545,"state_inc":"DE","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-06"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-06","q":[{"end":"2023-06-30","rev":3266600000.0,"rev_yoy":11.8,"eps":null,"eps_yoy":null,"ni":342400000.0,"ni_yoy":623.9,"nm":10.5,"derived":null,"fp":null},{"end":"2023-09-30","rev":3298400000.0,"rev_yoy":12.4,"eps":null,"eps_yoy":null,"ni":430700000.0,"ni_yoy":99.0,"nm":13.1,"derived":null,"fp":null},{"end":"2023-12-31","rev":2790800000.0,"rev_yoy":6.1,"eps":null,"eps_yoy":null,"ni":103300000.0,"ni_yoy":"turned +","nm":3.7,"derived":["rev","ni"],"fp":null},{"end":"2024-03-31","rev":2596400000.0,"rev_yoy":10.7,"eps":0.97,"eps_yoy":null,"ni":207800000.0,"ni_yoy":186.6,"nm":8.0,"derived":null,"fp":null},{"end":"2024-06-30","rev":3252300000.0,"rev_yoy":-0.4,"eps":2.03,"eps_yoy":null,"ni":427000000.0,"ni_yoy":24.7,"nm":13.1,"derived":null,"fp":null},{"end":"2024-09-30","rev":3042700000.0,"rev_yoy":-7.8,"eps":0.96,"eps_yoy":null,"ni":199800000.0,"ni_yoy":-53.6,"nm":6.6,"derived":null,"fp":null},{"end":"2024-12-31","rev":2735600000.0,"rev_yoy":-2.0,"eps":1.39,"eps_yoy":null,"ni":287800000.0,"ni_yoy":178.6,"nm":10.5,"derived":["eps","rev","ni"],"fp":null},{"end":"2025-03-31","rev":2304100000.0,"rev_yoy":-11.3,"eps":0.59,"eps_yoy":-39.2,"ni":121000000.0,"ni_yoy":-41.8,"nm":5.3,"derived":null,"fp":null},{"end":"2025-06-30","rev":3200800000.0,"rev_yoy":-1.6,"eps":2.13,"eps_yoy":4.9,"ni":428700000.0,"ni_yoy":0.4,"nm":13.4,"derived":null,"fp":null},{"end":"2025-09-30","rev":2973500000.0,"rev_yoy":-2.3,"eps":-14.79,"eps_yoy":-1640.6,"ni":-29276