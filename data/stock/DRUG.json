,"sector_n":374,"earn":12}},"biz":{"name":"BRIGHT MINDS BIOSCIENCES INC.","desc":"Bright Minds Biosciences Inc., a biotechnology company, develops therapeutics to improve the lives of patients with severe and life-altering diseases in the United States. Its portfolio includes 5-HT2 Receptors, which are serotonin agonists for epilepsy and neuropsychiatric disorders; and BMB-101, which has completed phase 1 trial for undisclosed seizure disorder and is in phase 2 clinical trials for the developmental and epileptic encephalopathies and absence epilepsies. The company also develops BMB-201 and BMB-202 for the treatment of neuropsychiatric and neurology indications; and BMB-105, a 5-HT2C agonist to treat Prader Willi Syndrome. Bright Minds Biosciences Inc. has a collaboration with Firefly Neuroscience, Inc. to provide an analysis of the electroencephalogram (EEG) data in the Company's BREAKTHROUGH study. The company was founded in 2017 and is headquartered in New York, New York.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"2834","sic_desc":"Pharmaceutical Preparations","sector":"Healthcare","industry":"Biotechnology","mcap":512931168,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"CHICAGO, IL","exchange":"XNAS","fy_end":"0930","cik":1827401,"state_inc":"A1","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-08"},"fin":{"available":true,"src":"Yahoo quarterly income statement via yfinance (third-party fallback)","asof":"2026-10-08","q":[{"end":"2025-03-31","rev":null,"rev_yoy":null,"eps":-0.42,"eps_yoy":null,"ni":null,"ni_yoy":null,"nm":null,"derived":null,"fp":null},{"end":"2025-06-30","rev":0.0,"rev_yoy":null,"eps":-0.74,"eps_yoy":null,"ni":-5242970.0,"ni_yoy":null,"nm":null,"derived":null,"fp":null},{"end":"2025-09-30","rev":0.0,"rev_yoy":null,"eps":null,"eps_yoy":null,"ni":-4085603.0,"ni_yoy":null,"nm":null,"derived":null,"fp":null},{"end":"2025-12-31","rev