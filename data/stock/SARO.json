luding maintenance, repair and overhaul, on-wing and field service support, asset management, and engineering and related solutions to customers in the commercial aerospace, military and helicopter, and business aviation end markets. The Component Repair Services segment offers engine component and accessory repairs to the commercial aerospace, military and helicopter, land and marine, and oil and gas end markets. StandardAero, Inc. was formerly known as Dynasty Parent Co., Inc. and changed its name to StandardAero, Inc. in September 2024. The company was founded in 1911 and is headquartered in Scottsdale, Arizona.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"3724","sic_desc":"Aircraft Engines & Engine Parts","sector":"Industrials","industry":"Aerospace & Defense","mcap":6965853696,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"SCOTTSDALE, AZ","exchange":"XNYS","fy_end":"1231","cik":2025410,"state_inc":"DE","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-03","q":[{"end":"2023-09-30","rev":1099441000.0,"rev_yoy":null,"eps":-0.06,"eps_yoy":null,"ni":-17933000.0,"ni_yoy":null,"nm":-1.6,"derived":null,"fp":null},{"end":"2023-12-31","rev":1157771000.0,"rev_yoy":null,"eps":-0.02,"eps_yoy":null,"ni":-4559000.0,"ni_yoy":null,"nm":-0.4,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":1235723000.0,"rev_yoy":null,"eps":0.02,"eps_yoy":null,"ni":3187000.0,"ni_yoy":"turned +","nm":0.3,"derived":null,"fp":null},{"end":"2024-06-30","rev":1347198000.0,"rev_yoy":null,"eps":0.02,"eps_yoy":null,"ni":5404000.0,"ni_yoy":"turned +","nm":0.4,"derived":null,"fp":null},{"end":"2024-09-30","rev":1244627000.0,"rev_yoy":13.2,"eps":0.06,"eps_yoy":"turned +","ni":16436000.0,"ni_yoy":"turned +","nm":1.3,"derived":null,"fp":null},{"end":"2024-12-31","rev":1409613000.0,"rev_yoy":21.8,"eps