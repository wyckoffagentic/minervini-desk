8/100.","status":"breakdown #1","last_sign":{"name":"No supply","d":"2026-08-20","pol":1,"sig":0.6,"tier":"low","why":"no selling pressure after climactic strength: background has changed","ref":null},"key_bars":[{"name":"Test","d":"2026-04-02","pol":1,"sig":0.98,"tier":"moderate"},{"name":"Effort to rise","d":"2026-05-01","pol":1,"sig":0.9,"tier":"moderate"},{"name":"Effort to rise","d":"2026-05-05","pol":1,"sig":1.05,"tier":"moderate"},{"name":"Buying climax","d":"2026-05-27","pol":-1,"sig":2.44,"tier":"high"},{"name":"No demand","d":"2026-07-09","pol":-1,"sig":0.9,"tier":"moderate"},{"name":"Effort to fall","d":"2026-07-29","pol":-1,"sig":0.9,"tier":"moderate"}],"asof":null},"scores":{"overall":31,"group":"whole universe","group_rank":343,"group_n":389,"sector_rank":451,"sector_n":519,"earn":50}},"biz":{"name":"DYCOM INDUSTRIES INC","desc":"Dycom Industries, Inc. provides specialty contracting services to the digital infrastructure, telecommunications infrastructure, and utility industries in the United States. It operates through Communications and Building Systems segments. The company offers engineering services to telecommunications providers, including the planning and design of aerial, underground, and buried fiber optic, copper, and coaxial cable systems; placement of cables, related structures, and drop lines for telephone companies and cable multiple system operators; program and project management, and inspection personnel; and wireless networks in connection with the deployment of macro cell and new small cell sites. It also provides construction, maintenance, and installation services, such as placement and splicing of copper, fiber, and coaxial cables; tower construction, lines and antenna installation, foundation and equipment pad construction, and small cell site placement for wireless carriers, as well as equipment installation and material fabrication, and site testing services; underground facility locating services, including locating telephone, cable television, power, water, sewer, and gas lines for utility companies; installation and maintenance of customer premise equipment for electric and gas utilities, and other customers. Dycom Industries, Inc. was incorporated in 1969 and is based in West Palm Beach, Florida.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"1623","sic_desc":"Water, Sewer, Pipeline, Comm & Power Line Construction","sector":"Industrials","industry":"Engineering & Construction","mcap":8046641664,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"WEST PALM BEACH, FL","exchange":"XNYS","fy_end":"0130","cik":67215,"state_inc":"FL","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-06"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-06","q":[{"end":"2023-10-28","rev":1136110000.0,"rev_yoy":9.0,"eps":2.82,"eps_yoy":56.7,"ni":83736000.0,"ni_yoy":55.0,"nm":7.4,"derived":null,"fp":null},{"end":"2024-01-27","rev":952455000.0,"rev_yoy":3.8,"eps":0.79,"eps_yoy":-4.8,"ni":23418000.0,"ni_yoy":-5.6,"nm":2.5,"derived":null,"fp":null},{"end":"2024-04-27","rev":1142423000.0,"rev_yoy":9.3,"eps":2.12,"eps_yoy":22.5,"ni":62554000.0,"ni_yoy":21.4,"nm":5.5,"derived":null,"fp":null},{"end":"2024-07-27","rev":1203059000.0,"rev_yoy":15.5,"eps":2.32,"eps_yoy":14.3,"ni":68400000.0,"ni_yoy":13.5,"nm":5.7,"derived":null,"fp":null},{"end":"2024-10-26","rev":1272007000.0,"rev_yoy":12.0,"eps":2.37,"eps_yoy":-16.0,"ni":69789000.0,"ni_yoy":-16.7,"nm":5.5,"derived":null,"fp":null},{"end":"2025-01-25","rev":1084525000.0,"rev_yoy":13.9,"eps":1.11,"eps_yoy":40.5,"ni":34257000.0,"ni_yoy":46.3,"nm":3.2,"derived":["eps","rev","ni"],"fp":null},{"end":"2025-04-26","rev":1258608000.0,"rev_yoy":10.2,"eps":2.09,"eps_yoy":-1.4,"ni":61048000.0,"ni_yoy":-2.4,"nm":4.9,"derived":null,"fp":null},{"end":"2025-07-26","rev":1377944000.0,"rev_yoy":14.5,"eps":3.33,"eps_yoy":43.5,"ni":97483000.0,"ni_yoy":42