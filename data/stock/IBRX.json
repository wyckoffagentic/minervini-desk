atform is built around the proprietary IL-15 superagonist ANKTIVA (nogapendekin alfa inbakicept) and is supported by a portfolio that includes adenovirus-vectored vaccines, NK-cell therapies, and additional immunomodulators. The company operates in the United States and Europe, with the majority of its revenue coming from the United States.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"2836","sic_desc":"Biological Products, (No Diagnostic Substances)","sector":"Healthcare","industry":"Biotechnology","mcap":9835280613.439999,"mcap_src":"Massive ticker details (2026-10-03)","shares":1059836273,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"SAN DIEGO, CA","website":"https://www.immunitybio.com","employees":691,"list_date":"2021-03-10","exchange":"XNAS","fy_end":"1231","cik":1326110,"state_inc":"DE","massive_asof":"2026-10-03","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-06","q":[{"end":"2023-09-30","rev":82000.0,"rev_yoy":-30.5,"eps":-0.19,"eps_yoy":32.1,"ni":-95582000.0,"ni_yoy":13.8,"nm":-116563.4,"derived":null,"fp":null},{"end":"2023-12-31","rev":139000.0,"rev_yoy":90.4,"eps":-0.38,"eps_yoy":-40.7,"ni":-234096000.0,"ni_yoy":-114.9,"nm":-168414.4,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":40000.0,"rev_yoy":-88.9,"eps":-0.2,"eps_yoy":25.9,"ni":-134109000.0,"ni_yoy":-15.3,"nm":-335272.5,"derived":null,"fp":null},{"end":"2024-06-30","rev":1047000.0,"rev_yoy":2453.7,"eps":-0.2,"eps_yoy":37.5,"ni":-134564000.0,"ni_yoy":2.4,"nm":-12852.3,"derived":null,"fp":null},{"end":"2024-09-30","rev":6106000.0,"rev_yoy":7346.3,"eps":-0.14,"eps_yoy":26.3,"ni":-85729000.0,"ni_yoy":10.3,"nm":-1404.0,"derived":null,"fp":null},{"end":"2024-12-31","rev":7552000.0,"rev_yoy":5333.1,"eps":-0.09,"eps_yoy":76.3,"ni":-59198000.0,"ni_yoy":74.7,"nm":-783.9,"derived":["eps","rev","ni"],"fp":null},{"end":"2025-03-31","rev":16517000.0,"rev_yoy":41192.5,"eps":-0.15,"eps_yoy"