estment advice, online banking, online statements, mobile banking with mobile deposit, Visa debit cards, and access. The company was formerly known as Heritage Financial Corporation, M.H.C. and changed its name to Heritage Financial Corporation in 1998. Heritage Financial Corporation was founded in 1927 and is headquartered in Olympia, Washington.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"6036","sic_desc":"Savings Institutions, Not Federally Chartered","sector":"Financial Services","industry":"Banks - Regional","mcap":1128041984,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"OLYMPIA, WA","exchange":"XNAS","fy_end":"1231","cik":1046025,"state_inc":"WA","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-09"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-09","q":[{"end":"2023-09-30","rev":73467000.0,"rev_yoy":20.2,"eps":0.51,"eps_yoy":-13.6,"ni":18219000.0,"ni_yoy":-13.2,"nm":24.8,"derived":null,"fp":null},{"end":"2023-12-31","rev":74262000.0,"rev_yoy":12.5,"eps":0.18,"eps_yoy":-71.9,"ni":6233000.0,"ni_yoy":-72.4,"nm":8.4,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":74353000.0,"rev_yoy":11.5,"eps":0.16,"eps_yoy":-72.4,"ni":5748000.0,"ni_yoy":-71.9,"nm":7.7,"derived":null,"fp":null},{"end":"2024-06-30","rev":76582000.0,"rev_yoy":9.3,"eps":0.41,"eps_yoy":-14.6,"ni":14159000.0,"ni_yoy":-16.0,"nm":18.5,"derived":null,"fp":null},{"end":"2024-09-30","rev":79817000.0,"rev_yoy":8.6,"eps":0.33,"eps_yoy":-35.3,"ni":11423000.0,"ni_yoy":-37.3,"nm":14.3,"derived":null,"fp":null},{"end":"2024-12-31","rev":78960000.0,"rev_yoy":6.3,"eps":0.34,"eps_yoy":88.9,"ni":11928000.0,"ni_yoy":91.4,"nm":15.1,"derived":["eps","rev","ni"],"fp":null},{"end":"2025-03-31","rev":77366000.0,"rev_yoy":4.1,"eps":0.4,"eps_yoy":150.0,"ni":13911000.0,"ni_yoy":142.0,"nm":18.0,"derived":null,"fp":null},{"end":"2025-06-30","rev":78500000.0,"rev_y