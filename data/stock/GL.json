 via yfinance (third-party)","sic":"6311","sic_desc":"Life Insurance","sector":"Financial Services","industry":"Insurance - Life","mcap":12810034176,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"MCKINNEY, TX","exchange":"XNYS","fy_end":"1231","cik":320335,"state_inc":"DE","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-09-29","q":[{"end":"2023-09-30","rev":1384118000.0,"rev_yoy":6.7,"eps":2.68,"eps_yoy":38.1,"ni":257083000.0,"ni_yoy":34.9,"nm":18.6,"derived":null,"fp":null},{"end":"2023-12-31","rev":1415691000.0,"rev_yoy":6.0,"eps":2.88,"eps_yoy":17.1,"ni":274802000.0,"ni_yoy":13.4,"nm":19.4,"derived":null,"fp":null},{"end":"2024-03-31","rev":1416139000.0,"rev_yoy":7.2,"eps":2.67,"eps_yoy":17.1,"ni":254217000.0,"ni_yoy":13.7,"nm":18.0,"derived":null,"fp":null},{"end":"2024-06-30","rev":1440246000.0,"rev_yoy":8.6,"eps":2.83,"eps_yoy":26.3,"ni":258355000.0,"ni_yoy":20.0,"nm":17.9,"derived":null,"fp":null},{"end":"2024-09-30","rev":1455407000.0,"rev_yoy":5.2,"eps":3.44,"eps_yoy":28.4,"ni":302994000.0,"ni_yoy":17.9,"nm":20.8,"derived":null,"fp":null},{"end":"2024-12-31","rev":1466277000.0,"rev_yoy":3.6,"eps":3.01,"eps_yoy":4.5,"ni":255196000.0,"ni_yoy":-7.1,"nm":17.4,"derived":["eps","rev","ni"],"fp":null},{"end":"2025-03-31","rev":1480422000.0,"rev_yoy":4.5,"eps":3.01,"eps_yoy":12.7,"ni":254563000.0,"ni_yoy":0.1,"nm":17.2,"derived":null,"fp":null},{"end":"2025-06-30","rev":1481287000.0,"rev_yoy":2.8,"eps":3.05,"eps_yoy":7.8,"ni":252749000.0,"ni_yoy":-2.2,"nm":17.1,"derived":null,"fp":null},{"end":"2025-09-30","rev":1512988000.0,"rev_yoy":4.0,"eps":4.73,"eps_yoy":37.5,"ni":387843000.0,"ni_yoy":28.0,"nm":25.6,"derived":null,"fp":null},{"end":"2025-12-31","rev":1519621000.0,"rev_yoy":3.6,"eps":3.3,"eps_yoy":9.6,"ni":266083000.0,"ni_yoy":4.3,"nm":17.5,"derived":["eps","rev","ni"],"fp":null},{"end":"2026-0