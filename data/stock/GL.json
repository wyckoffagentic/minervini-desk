"name":"Globe Life Inc.","desc":"Globe Life Inc is an insurance holding company. It provides a variety of life and supplemental health insurance products and annuities to a broad base of customers. The company's core operations are organized into three reportable segments: life insurance, supplemental health insurance and investments. Investment activities, conducted by the investment segment, focus on seeking investments with a yield and term appropriate to support the insurance product obligations. These investments generally consist of fixed maturities and, over the long term, the expected yields are considered when setting insurance premium rates and product profitability expectations.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"6311","sic_desc":"Life Insurance","sector":"Financial Services","industry":"Insurance - Life","mcap":12743943796.01,"mcap_src":"Massive ticker details (2026-10-03)","shares":76849447,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"MCKINNEY, TX","website":"https://www.globelifeinsurance.com","employees":3695,"list_date":"1980-12-31","exchange":"XNYS","fy_end":"1231","cik":320335,"state_inc":"DE","massive_asof":"2026-10-03","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-06","q":[{"end":"2023-09-30","rev":1384118000.0,"rev_yoy":6.7,"eps":2.68,"eps_yoy":38.1,"ni":257083000.0,"ni_yoy":34.9,"nm":18.6,"derived":null,"fp":null},{"end":"2023-12-31","rev":1415691000.0,"rev_yoy":6.0,"eps":2.88,"eps_yoy":17.1,"ni":274802000.0,"ni_yoy":13.4,"nm":19.4,"derived":null,"fp":null},{"end":"2024-03-31","rev":1416139000.0,"rev_yoy":7.2,"eps":2.67,"eps_yoy":17.1,"ni":254217000.0,"ni_yoy":13.7,"nm":18.0,"derived":null,"fp":null},{"end":"2024-06-30","rev":1440246000.0,"rev_yoy":8.6,"eps":2.83,"eps_yoy":26.3,"ni":258355000.0,"ni_yoy":20.0,"nm":17.9,"derived":null,"fp":null},{"end":"2024-09-30","rev":1455407000.0,"rev_yoy":5.2,"eps":3.44,"eps_yoy":28.4,"ni":30