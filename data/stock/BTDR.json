_n":424,"earn":23}},"biz":{"name":"Bitdeer Technologies Group","desc":"Bitdeer Technologies Group operates as a technology company for blockchain and high-performance computing (HPC) in Singapore, the United States, Bhutan, Norway, Finland, Ethiopia, Canada, and internationally. The company offers hash rate sharing solutions, including cloud hash rate and hash-rate subscription plans; and a one-stop mining rig hosting solution comprising deployment, maintenance, and management services for cryptocurrency mining; as well as mining cryptocurrencies for its own account. It also operates mining datacenters to generate hash rates; handles various processes involved in computing, such as equipment procurement, transport logistics, datacenter design and construction, equipment management, and daily operations; and sells mining rigs. In addition, the company offers Minerplus, a software platform that offers software support to reduce time needed for daily maintenance and mining rig upgrade; AI infrastructure and AI cloud business to offer advanced AI cloud capabilities, HPC services and colocation services; and mining solutions under the SEALMINER brand. The company is headquartered in Singapore.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"6199","sic_desc":"Finance Services","sector":"Technology","industry":"Software - Application","mcap":2995040512,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"SINGAPORE","exchange":"XNAS","fy_end":"1231","cik":1899123,"state_inc":"E9","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-10"},"fin":{"available":true,"src":"Yahoo quarterly income statement via yfinance (third-party fallback)","asof":"2026-10-10","q":[{"end":"2025-03-31","rev":null,"rev_yoy":null,"eps":null,"eps_yoy":null,"ni":null,"ni_yoy":null,"nm":null,"derived":null,"fp":null},{"end":"2025-06-30","rev":155582000.0,"rev_yoy":null,"eps":-0.32,"eps_yoy":null,"ni"