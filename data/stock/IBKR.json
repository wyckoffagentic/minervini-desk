4,"sector_rank":92,"sector_n":425,"earn":56}},"biz":{"name":"Interactive Brokers Group, Inc. Class A Common Stock","desc":"Interactive Brokers is a large, automated retail and institutional brokerage that boasted nearly $780 billion in customer equity at the end of 2025. The company cut its teeth as a market maker, introducing US financial markets to automated and algorithmic training before expanding into brokerage services in 1993. The firm has a wide-ranging client base, with its best-in-class order execution and extremely low margin lending rates catering to a sophisticated audience of hedge funds, proprietary traders, and introducing brokers that account for about 45% of the firm's commissions. With operations spanning more than 170 electronic exchanges, 40 countries, and 29 currencies, Interactive Brokers caters to a global clientele, with more than 80% of active accounts sitting outside the US.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"6211","sic_desc":"Security Brokers, Dealers & Flotation Companies","sector":"Financial Services","industry":"Capital Markets","mcap":40006802499.299995,"mcap_src":"Massive ticker details (2026-10-03)","shares":453077771,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"GREENWICH, CT","website":"https://www.interactivebrokers.com","employees":3265,"list_date":"2007-05-04","exchange":"XNAS","fy_end":"1231","cik":1381197,"state_inc":"DE","massive_asof":"2026-10-03","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-06","q":[{"end":"2023-09-30","rev":1145000000.0,"rev_yoy":44.9,"eps":1.56,"eps_yoy":60.8,"ni":772000000.0,"ni_yoy":59.8,"nm":67.4,"derived":null,"fp":null},{"end":"2023-12-31","rev":1139000000.0,"rev_yoy":16.7,"eps":-2.77,"eps_yoy":-309.8,"ni":739000000.0,"ni_yoy":16.7,"nm":64.9,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":1203000000.0,"rev_yoy":13.9,"eps":1.61,"eps_yoy":13.4,"ni":795000000.0,"ni_yoy