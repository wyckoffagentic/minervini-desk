), and donor management software designed for commercial plasma collectors. Hospital segment includes Blood Management Technologies (hemostasis analyzers, cell salvage systems) and Interventional Technologies. And the Blood Center provides solutions and devices enabling blood centers to harvest essential components like platelets and red blood cells.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"3841","sic_desc":"Surgical & Medical Instruments & Apparatus","sector":"Healthcare","industry":"Medical Devices","mcap":4748527212.87,"mcap_src":"Massive ticker details (2026-10-03)","shares":45497051,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"BOSTON, MA","website":"https://www.haemonetics.com","employees":3009,"list_date":"1991-05-09","exchange":"XNYS","fy_end":"0403","cik":313143,"state_inc":"MA","massive_asof":"2026-10-03","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-06","q":[{"end":"2023-09-30","rev":318183000.0,"rev_yoy":7.0,"eps":0.48,"eps_yoy":-25.0,"ni":24908000.0,"ni_yoy":-25.0,"nm":7.8,"derived":null,"fp":null},{"end":"2023-12-30","rev":336250000.0,"rev_yoy":10.1,"eps":0.61,"eps_yoy":-4.7,"ni":31241000.0,"ni_yoy":-5.2,"nm":9.3,"derived":null,"fp":null},{"end":"2024-03-30","rev":343290000.0,"rev_yoy":12.8,"eps":0.4,"eps_yoy":-29.8,"ni":20367000.0,"ni_yoy":-30.7,"nm":5.9,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-06-29","rev":336172000.0,"rev_yoy":8.0,"eps":0.74,"eps_yoy":-7.5,"ni":38373000.0,"ni_yoy":-6.5,"nm":11.4,"derived":null,"fp":null},{"end":"2024-09-28","rev":345511000.0,"rev_yoy":8.6,"eps":0.66,"eps_yoy":37.5,"ni":33831000.0,"ni_yoy":35.8,"nm":9.8,"derived":null,"fp":null},{"end":"2024-12-28","rev":348542000.0,"rev_yoy":3.7,"eps":0.74,"eps_yoy":21.3,"ni":37494000.0,"ni_yoy":20.0,"nm":10.8,"derived":null,"fp":null},{"end":"2025-03-29","rev":330599000.0,"rev_yoy":-3.7,"eps":1.17,"eps_yoy":192.5,"ni":-109530321.0,"ni_yoy":-637.8,"nm":-33.1,"de