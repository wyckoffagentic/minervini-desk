nd operates three polymetallic mines in Peru and two polymetallic mines in Brazil; zinc smelter in Peru and two zinc smelters in Brazil. The company was formerly known as VM Holding S.A. and changed its name to Nexa Resources S.A. in September 2017. The company was founded in 1956 and is based in Luxembourg, Luxembourg. Nexa Resources S.A. is a subsidiary of Votorantim S.A.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"1000","sic_desc":"Metal Mining","sector":"Basic Materials","industry":"Other Industrial Metals & Mining","mcap":1619724160,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"LUXEMBOURG","exchange":"XNYS","fy_end":"1231","cik":1713930,"state_inc":"N4","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-10"},"fin":{"available":true,"src":"Yahoo quarterly income statement via yfinance (third-party fallback)","asof":"2026-10-06","q":[{"end":"2025-06-30","rev":708422000.0,"rev_yoy":null,"eps":0.01,"eps_yoy":null,"ni":1083000.0,"ni_yoy":null,"nm":0.2,"derived":null,"fp":null},{"end":"2025-09-30","rev":763515000.0,"rev_yoy":null,"eps":0.52,"eps_yoy":null,"ni":69340000.0,"ni_yoy":null,"nm":9.1,"derived":null,"fp":null},{"end":"2025-12-31","rev":903003000.0,"rev_yoy":null,"eps":-0.74,"eps_yoy":null,"ni":50354000.0,"ni_yoy":null,"nm":5.6,"derived":null,"fp":null},{"end":"2026-03-31","rev":888321000.0,"rev_yoy":null,"eps":0.67,"eps_yoy":null,"ni":89306000.0,"ni_yoy":null,"nm":10.1,"derived":null,"fp":null},{"end":"2026-06-30","rev":907935000.0,"rev_yoy":28.2,"eps":0.52,"eps_yoy":5100.0,"ni":68605000.0,"ni_yoy":6234.7,"nm":7.6,"derived":null,"fp":null}],"a":[{"end":"2020-12-31","rev":1950929000.0,"rev_yoy":null,"eps":-4.22,"eps_yoy":null,"ni":-652506000.0,"nm":-33.4},{"end":"2021-12-31","rev":2622110000.0,"rev_yoy":34.4,"eps":0.86,"eps_yoy":null,"ni":156087000.0,"nm":6.0},{"end":"2022-12-31","rev":3033990000.0,"rev_yoy":15.71,"eps":0.38,"eps_yoy":-55.81,"ni