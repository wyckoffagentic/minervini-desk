s. It provides implementation services, such as configuration, data migration and implementation, and support and training; E-invoicing, an end-to-end e-invoicing process; and managed services, including indirect tax return preparation, filing and tax payment, and notice management. The company sells its software products through software licenses and software as a service subscription. Vertex, Inc. has a strategic collaboration with xSuite Group GmbH to support SAP customers. The company was founded in 1978 and is headquartered in King of Prussia, Pennsylvania.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"7372","sic_desc":"Services-Prepackaged Software","sector":"Technology","industry":"Software - Application","mcap":1948238080,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"KING OF PRUSSIA, PA","exchange":"XNAS","fy_end":"1231","cik":1806837,"state_inc":"DE","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"Yahoo quarterly income statement via yfinance (third-party fallback)","asof":"2026-10-03","q":[{"end":"2025-03-31","rev":null,"rev_yoy":null,"eps":null,"eps_yoy":null,"ni":null,"ni_yoy":null,"nm":null,"derived":null,"fp":null},{"end":"2025-06-30","rev":184559000.0,"rev_yoy":null,"eps":-0.01,"eps_yoy":null,"ni":-961000.0,"ni_yoy":null,"nm":-0.5,"derived":null,"fp":null},{"end":"2025-09-30","rev":192112000.0,"rev_yoy":null,"eps":0.02,"eps_yoy":null,"ni":4045000.0,"ni_yoy":null,"nm":2.1,"derived":null,"fp":null},{"end":"2025-12-31","rev":194711000.0,"rev_yoy":null,"eps":-0.04,"eps_yoy":null,"ni":-7003000.0,"ni_yoy":null,"nm":-3.6,"derived":null,"fp":null},{"end":"2026-03-31","rev":196646000.0,"rev_yoy":null,"eps":-0.02,"eps_yoy":null,"ni":-2510000.0,"ni_yoy":null,"nm":-1.3,"derived":null,"fp":null},{"end":"2026-06-30","rev":203970000.0,"rev_yoy":10.5,"eps":0.06,"eps_yoy":"turned +","ni":9043000.0,"ni_yoy":"turned +",