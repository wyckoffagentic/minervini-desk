te-sector customers comprising federal, state, and municipal governments; industrial, commercial, and residential developers, as well as other private parties; and provides its contracting services to public-sector customers for the development and servicing of highways, local roads, bridges, and other public-infrastructure projects. Knife River Corporation was founded in 1917 and is headquartered in Bismarck, North Dakota.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"1400","sic_desc":"Mining & Quarrying of  Nonmetallic Minerals (No Fuels)","sector":"Basic Materials","industry":"Building Materials","mcap":2856902912,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"BISMARCK, ND","exchange":"XNYS","fy_end":"1231","cik":1955520,"state_inc":"DE","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-03","q":[{"end":"2023-09-30","rev":1090372000.0,"rev_yoy":11.8,"eps":2.58,"eps_yoy":46.6,"ni":146655000.0,"ni_yoy":47.2,"nm":13.4,"derived":null,"fp":null},{"end":"2023-12-31","rev":646888000.0,"rev_yoy":20.3,"eps":0.37,"eps_yoy":19.4,"ni":20701000.0,"ni_yoy":14.9,"nm":3.2,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":329590000.0,"rev_yoy":7.0,"eps":-0.84,"eps_yoy":-15.1,"ni":-47629000.0,"ni_yoy":-15.3,"nm":-14.5,"derived":null,"fp":null},{"end":"2024-06-30","rev":806906000.0,"rev_yoy":2.8,"eps":1.37,"eps_yoy":37.0,"ni":77929000.0,"ni_yoy":37.1,"nm":9.7,"derived":null,"fp":null},{"end":"2024-09-30","rev":1105293000.0,"rev_yoy":1.4,"eps":2.6,"eps_yoy":0.8,"ni":148104000.0,"ni_yoy":1.0,"nm":13.4,"derived":null,"fp":null},{"end":"2024-12-31","rev":657216000.0,"rev_yoy":1.6,"eps":0.41,"eps_yoy":10.8,"ni":23273000.0,"ni_yoy":12.4,"nm":3.5,"derived":["eps","rev","ni"],"fp":null},{"end":"2025-03-31","rev":353471000.0,"rev_yoy":7.2,"eps":-1.21,"eps_yoy":-44.0,"ni":-68710000.0,"