ronary plaque, enabling optimized medical treatment strategies. Its platform provides insights on blood flow, stenosis, and plaque volume and composition by overcoming the limitations of traditional non-invasive imaging tests. HeartFlow, Inc. was formerly known as Cardiovascular Simulation, Inc. and changed its name to HeartFlow, Inc. in May 2009. The company was incorporated in 2007 and is headquartered in San Francisco, California.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"3841","sic_desc":"Surgical & Medical Instruments & Apparatus","sector":"Healthcare","industry":"Health Information Services","mcap":4275509504,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"SAN FRANCISCO, CA","exchange":"XNAS","fy_end":"1231","cik":1464521,"state_inc":"DE","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-09-28","q":[{"end":"2024-03-31","rev":null,"rev_yoy":null,"eps":null,"eps_yoy":null,"ni":-20932000.0,"ni_yoy":null,"nm":null,"derived":null,"fp":null},{"end":"2024-06-30","rev":31054000.0,"rev_yoy":null,"eps":-4.66,"eps_yoy":null,"ni":-23379000.0,"ni_yoy":null,"nm":-75.3,"derived":null,"fp":null},{"end":"2024-09-30","rev":32934000.0,"rev_yoy":null,"eps":-3.43,"eps_yoy":null,"ni":-19140000.0,"ni_yoy":null,"nm":-58.1,"derived":null,"fp":null},{"end":"2024-12-31","rev":34977000.0,"rev_yoy":null,"eps":-5.74,"eps_yoy":null,"ni":-32975000.0,"ni_yoy":null,"nm":-94.3,"derived":["eps","rev","ni"],"fp":null},{"end":"2025-03-31","rev":37205000.0,"rev_yoy":null,"eps":-5.25,"eps_yoy":null,"ni":-32345000.0,"ni_yoy":-54.5,"nm":-86.9,"derived":null,"fp":null},{"end":"2025-06-30","rev":43424000.0,"rev_yoy":39.8,"eps":-1.46,"eps_yoy":68.7,"ni":-9196000.0,"ni_yoy":60.7,"nm":-21.2,"derived":null,"fp":null},{"end":"2025-09-30","rev":46276000.0,"rev_yoy":40.5,"eps":-1.04,"eps_yoy":69.7,"ni":-50855000.0,"ni_