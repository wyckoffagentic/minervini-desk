 other conditions.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"2834","sic_desc":"Pharmaceutical Preparations","sector":"Healthcare","industry":"Biotechnology","mcap":5523213090.58,"mcap_src":"Massive ticker details (2026-10-03)","shares":66209699,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"MENLO PARK, CA","website":"https://www.orukatx.com","employees":68,"list_date":"2024-09-03","exchange":"XNAS","fy_end":"1231","cik":907654,"state_inc":"DE","massive_asof":"2026-10-03","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-09-28","q":[{"end":"2023-06-30","rev":null,"rev_yoy":null,"eps":-0.1,"eps_yoy":54.5,"ni":-1480000.0,"ni_yoy":53.0,"nm":null,"derived":null,"fp":null},{"end":"2023-09-30","rev":null,"rev_yoy":null,"eps":-0.1,"eps_yoy":37.5,"ni":-1424000.0,"ni_yoy":39.0,"nm":null,"derived":null,"fp":null},{"end":"2023-12-31","rev":0.0,"rev_yoy":null,"eps":-0.08,"eps_yoy":0.0,"ni":-1089000.0,"ni_yoy":7.2,"nm":null,"derived":["eps","rev"],"fp":null},{"end":"2024-03-31","rev":0.0,"rev_yoy":null,"eps":-0.14,"eps_yoy":-55.6,"ni":-2009000.0,"ni_yoy":-49.3,"nm":null,"derived":null,"fp":null},{"end":"2024-06-30","rev":null,"rev_yoy":null,"eps":-6.96,"eps_yoy":-6860.0,"ni":-22243000.0,"ni_yoy":-1402.9,"nm":null,"derived":null,"fp":null},{"end":"2024-09-30","rev":null,"rev_yoy":null,"eps":-1.46,"eps_yoy":-1360.0,"ni":-28623000.0,"ni_yoy":-1910.0,"nm":null,"derived":null,"fp":null},{"end":"2025-03-31","rev":null,"rev_yoy":null,"eps":-0.4,"eps_yoy":-185.7,"ni":-20999000.0,"ni_yoy":-945.2,"nm":null,"derived":null,"fp":null},{"end":"2025-06-30","rev":null,"rev_yoy":null,"eps":-0.46,"eps_yoy":93.4,"ni":-24574000.0,"ni_yoy":-10.5,"nm":null,"derived":null,"fp":null},{"end":"2025-09-30","rev":null,"rev_yoy":null,"eps":null,"eps_yoy":null,"ni":-30277000.0,"ni_yoy":-5.8,"nm":null,"derived":null,"fp":null},{"end":"2025-12-31","rev":null,"rev_yoy":null,"eps":null,"eps_yoy":null,"ni":-295830