, the company operates in Australia, Asia, Europe, and America, with maximum revenue from the Australia-Asia region. It has two reporting segments: Container vessels and Drybulk vessels segment. It generates the majority of its revenue from Container vessels.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"4412","sic_desc":"Deep Sea Foreign Transportation of  Freight","sector":"Industrials","industry":"Marine Shipping","mcap":3006319090.05,"mcap_src":"Massive ticker details (2026-10-03)","shares":18203567,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"ATHENS","website":"https://www.danaos.com","employees":4398,"list_date":"2006-10-06","exchange":"XNYS","fy_end":"1231","cik":1369241,"state_inc":"1T","massive_asof":"2026-10-03","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-06","q":[{"end":"2020-03-31","rev":null,"rev_yoy":null,"eps":null,"eps_yoy":null,"ni":29089000.0,"ni_yoy":-13.0,"nm":null,"derived":null,"fp":null},{"end":"2020-06-30","rev":116824000.0,"rev_yoy":4.0,"eps":1.55,"eps_yoy":-21.3,"ni":38496000.0,"ni_yoy":27.7,"nm":33.0,"derived":null,"fp":null},{"end":"2021-03-31","rev":null,"rev_yoy":null,"eps":null,"eps_yoy":null,"ni":296780000.0,"ni_yoy":920.2,"nm":null,"derived":null,"fp":null},{"end":"2021-06-30","rev":146434000.0,"rev_yoy":25.3,"eps":18.1,"eps_yoy":1067.7,"ni":372837000.0,"ni_yoy":868.5,"nm":254.6,"derived":null,"fp":null},{"end":"2022-03-31","rev":null,"rev_yoy":null,"eps":null,"eps_yoy":null,"ni":331465000.0,"ni_yoy":11.7,"nm":null,"derived":null,"fp":null},{"end":"2022-06-30","rev":250923000.0,"rev_yoy":71.4,"eps":0.4,"eps_yoy":-97.8,"ni":8224000.0,"ni_yoy":-97.8,"nm":3.3,"derived":null,"fp":null},{"end":"2023-03-31","rev":null,"rev_yoy":null,"eps":null,"eps_yoy":null,"ni":146201000.0,"ni_yoy":-55.9,"nm":null,"derived":null,"fp":null},{"end":"2023-06-30","rev":241479000.0,"rev_yoy":-3.8,"eps":7.32,"eps_yoy":1730.0,"ni":147021000.0,"ni_yoy":16