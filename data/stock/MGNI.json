ector_rank":96,"sector_n":395,"earn":56}},"biz":{"name":"Magnite, Inc. Common Stock","desc":"Magnite is a supply-side advertising platform that provides technology and yield management solutions to content publishers, enabling them to monetize their digital advertising inventory. Magnite receives a percentage of all advertising inventory that it sells. 43% of Magnite's revenue is derived from connected television, or CTV, streaming platforms, 40% from mobile applications, and the remainder from general websites. Beyond the typical monetization responsibilities inherent to an SSP, Magnite also provides upstream advertising servers to CTV publishers, allowing them to have granular control over direct-sold, programmatic guaranteed, and open-auction logic. Magnite competes with other independent SSPs, supply path optimization solutions, and closed ecosystems like Meta.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"7370","sic_desc":"Services-Computer Programming, Data Processing, Etc.","sector":"Communication Services","industry":"Advertising Agencies","mcap":3648710554.0800004,"mcap_src":"Massive ticker details (2026-10-03)","shares":143424157,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"NEW YORK, NY","website":"https://www.magnite.com","employees":971,"list_date":"2014-04-02","exchange":"XNAS","fy_end":"1231","cik":1595974,"state_inc":"DE","massive_asof":"2026-10-03","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-06","q":[{"end":"2023-09-30","rev":150085000.0,"rev_yoy":2.9,"eps":-0.13,"eps_yoy":27.8,"ni":-17477000.0,"ni_yoy":28.3,"nm":-11.6,"derived":null,"fp":null},{"end":"2023-12-31","rev":186932000.0,"rev_yoy":6.6,"eps":0.23,"eps_yoy":"turned +","ni":30914000.0,"ni_yoy":"turned +","nm":16.5,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":149319000.0,"rev_yoy":14.7,"eps":-0.13,"eps_yoy":82.2,"ni":-17757000.0,"ni_yoy":82.0,"nm":-11.9,"derived":nu