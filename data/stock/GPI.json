0}},"biz":{"name":"Group 1 Automotive, Inc.","desc":"Group 1 owns and operates 32 collision centers and over 250 automotive dealerships in the US and the UK, offering 36 brands of automobiles altogether. Slightly over half of the stores are in the US with locations mostly in metropolitan areas in 17 states in the Northeast, Southeast, Midwest, and California. Texas alone contributed 31.6% of new-vehicle unit volume in 2025 and the UK 27.6%. Texas, Massachusetts, and California combined was 45.4%. Revenue in 2025 totaled $22.6 billion. The firm entered the UK in 2007 and has 106 stores there contributing about 26% of total revenue. Group 1 was founded in 1995 and is based in Houston.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"5500","sic_desc":"Retail-Auto Dealers & Gasoline Stations","sector":"Consumer Cyclical","industry":"Auto & Truck Dealerships","mcap":3060435157.5,"mcap_src":"Massive ticker details (2026-10-03)","shares":11922225,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"HOUSTON, TX","website":"https://www.group1auto.com","employees":20452,"list_date":"1997-10-30","exchange":"XNYS","fy_end":"1231","cik":1031203,"state_inc":"DE","massive_asof":"2026-10-03","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-03","q":[{"end":"2023-09-30","rev":4705100000.0,"rev_yoy":13.0,"eps":11.65,"eps_yoy":-6.7,"ni":163900000.0,"ni_yoy":-16.2,"nm":3.5,"derived":null,"fp":null},{"end":"2023-12-31","rev":4480000000.0,"rev_yoy":10.1,"eps":7.94,"eps_yoy":-27.1,"ni":108700000.0,"ni_yoy":-30.7,"nm":2.4,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":4470500000.0,"rev_yoy":8.2,"eps":10.8,"eps_yoy":-2.7,"ni":147900000.0,"ni_yoy":-6.6,"nm":3.3,"derived":null,"fp":null},{"end":"2024-06-30","rev":4696400000.0,"rev_yoy":3.0,"eps":10.17,"eps_yoy":-15.5,"ni":138200000.0,"ni_yoy":-18.9,"nm":2.9,"derived":null,"fp":null},{"end":"2024-09-30","rev":5221400000.0,"rev_yoy":11