fort to rise","d":"2026-09-30","pol":1,"sig":1.2,"tier":"moderate"}],"asof":null},"scores":{"overall":44,"group":"SIC 283x (Chemicals & Pharma)","group_rank":123,"group_n":239,"sector_rank":195,"sector_n":374,"earn":36}},"biz":{"name":"United Therapeutics Corp","desc":"United Therapeutics Corp specializes in drug development for pulmonary arterial hypertension (PAH), a rare and progressive disease marked by abnormally high blood pressure in the arteries of the lungs. The company's therapies for PAH largely focus on the prostacyclin pathway, and many of its treatments are based on the same molecule, treprostinil. The company markets and sells the following commercial therapies in the United States to treat PAH: Tyvaso DPI (treprostinil) Inhalation Powder, Remodulin Injection, Orenitram (treprostinil) Extended-Release Tablets, Adcirca (tadalafil) Tablets, and Unituxin. It derives maximum revenue from the sale of Tyvaso DPI. Geographically, the company operates in United States and Rest of the World, of which United States generates majority of the revenue.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"2834","sic_desc":"Pharmaceutical Preparations","sector":"Healthcare","industry":"Drug Manufacturers - Specialty & Generic","mcap":24506883594.96,"mcap_src":"Massive ticker details (2026-10-03)","shares":42890692,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"SILVER SPRING, MD","website":"https://www.unither.com","employees":1400,"list_date":"1999-06-17","exchange":"XNAS","fy_end":"1231","cik":1082554,"state_inc":"DE","massive_asof":"2026-10-03","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-06","q":[{"end":"2023-09-30","rev":609400000.0,"rev_yoy":18.1,"eps":5.38,"eps_yoy":9.6,"ni":267600000.0,"ni_yoy":11.8,"nm":43.9,"derived":null,"fp":null},{"end":"2023-12-31","rev":614700000.0,"rev_yoy":25.1,"eps":4.33,"eps_yoy":63.4,"ni":217100000.0,"ni_yoy":64.3,"nm":35.3,"derived"