tal Operations. It is focused on the ownership of farms and farm-related properties that are leased on a triple-net basis to tenants with a good operating history and deep farming resources. The farmland is predominantly concentrated in locations where farmers are able to grow either fresh produce or annual row crops (e.g., certain berries and vegetables), which are typically planted and harvested annually, or certain permanent crops (e.g., almonds, blueberries, pistachios, and wine grapes). To a much lesser extent, it also owns farms that grow certain commodity crops (e.g., corn and beans).","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"6798","sic_desc":"Real Estate Investment Trusts","sector":"Real Estate","industry":"REIT - Specialty","mcap":411522906.41999996,"mcap_src":"Massive ticker details (2026-10-03)","shares":43136573,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"MCLEAN, VA","website":"https://www.gladstonefarms.com","list_date":"2013-01-29","exchange":"XNAS","fy_end":"1231","cik":1495240,"state_inc":"MD","massive_asof":"2026-10-03","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-03","q":[{"end":"2023-09-30","rev":23534000.0,"rev_yoy":-2.8,"eps":-0.08,"eps_yoy":20.0,"ni":3141000.0,"ni_yoy":74.1,"nm":13.3,"derived":null,"fp":null},{"end":"2023-12-31","rev":24452000.0,"rev_yoy":-1.4,"eps":-0.12,"eps_yoy":7.7,"ni":1819000.0,"ni_yoy":63.7,"nm":7.4,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":20252000.0,"rev_yoy":-4.5,"eps":0.21,"eps_yoy":"turned +","ni":13567000.0,"ni_yoy":675.3,"nm":67.0,"derived":null,"fp":null},{"end":"2024-06-30","rev":21297000.0,"rev_yoy":0.4,"eps":-0.19,"eps_yoy":-480.0,"ni":-823000.0,"ni_yoy":-110.5,"nm":-3.9,"derived":null,"fp":null},{"end":"2024-09-30","rev":22571000.0,"rev_yoy":-4.1,"eps":-0.16,"eps_yoy":-100.0,"ni":6000.0,"ni_yoy":-99.8,"nm":0.0,"derived":null,"fp":null},{"end":"2024-12-31","rev":21096000.0,"r