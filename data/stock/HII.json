 News produces nuclear-powered ships as the only producer of Gerald Ford-class aircraft carriers and a major subcontractor on Virginia- and Columbia-class nuclear submarines. HII shares production of destroyers and nuclear submarines with General Dynamics' Bath Iron Works and Electric Boat shipyards, respectively. The company's mission technologies segment produces uncrewed sea vessels and provides a range of IT and other services to US government agencies.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"3730","sic_desc":"Ship & Boat Building & Repairing","sector":"Industrials","industry":"Aerospace & Defense","mcap":10809863369.34,"mcap_src":"Massive ticker details (2026-10-03)","shares":39404598,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"NEWPORT NEWS, VA","website":"https://www.huntingtoningalls.com","employees":45000,"list_date":"2011-03-22","exchange":"XNYS","fy_end":"1231","cik":1501585,"state_inc":"DE","massive_asof":"2026-10-03","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-03","q":[{"end":"2023-09-30","rev":2816000000.0,"rev_yoy":7.2,"eps":3.7,"eps_yoy":7.6,"ni":148000000.0,"ni_yoy":7.2,"nm":5.3,"derived":null,"fp":null},{"end":"2023-12-31","rev":3177000000.0,"rev_yoy":13.0,"eps":6.89,"eps_yoy":124.4,"ni":274000000.0,"ni_yoy":122.8,"nm":8.6,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":2805000000.0,"rev_yoy":4.9,"eps":3.87,"eps_yoy":19.8,"ni":153000000.0,"ni_yoy":18.6,"nm":5.5,"derived":null,"fp":null},{"end":"2024-06-30","rev":2977000000.0,"rev_yoy":6.8,"eps":4.38,"eps_yoy":33.9,"ni":173000000.0,"ni_yoy":33.1,"nm":5.8,"derived":null,"fp":null},{"end":"2024-09-30","rev":2749000000.0,"rev_yoy":-2.4,"eps":2.56,"eps_yoy":-30.8,"ni":101000000.0,"ni_yoy":-31.8,"nm":3.7,"derived":null,"fp":null},{"end":"2024-12-31","rev":3004000000.0,"rev_yoy":-5.4,"eps":3.15,"eps_yoy":-54.3,"ni":123000000.0,"ni_yoy":-55.1,"nm":4.1,"derived":["eps","rev","