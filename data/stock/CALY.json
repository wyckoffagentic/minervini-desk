avisMathew and OGIO brand. It sells its products through golf retailers, sporting goods retailers, online retailers, mass merchants, department stores, third-party distributors, and merchants, and directly to consumers through its retail stores and websites. The company was formerly known as Topgolf Callaway Brands Corp. and changed its name to Callaway Golf Company in January 2026. The company was incorporated in 1982 and is headquartered in Carlsbad, California.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"3949","sic_desc":"Sporting & Athletic Goods, NEC","sector":"Consumer Cyclical","industry":"Leisure","mcap":2554485760,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"CARLSBAD, CA","exchange":"XNYS","fy_end":"1231","cik":837465,"state_inc":"DE","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-09-29","q":[{"end":"2023-09-30","rev":1040600000.0,"rev_yoy":5.3,"eps":0.16,"eps_yoy":-20.0,"ni":29700000.0,"ni_yoy":-22.9,"nm":2.9,"derived":null,"fp":null},{"end":"2023-12-31","rev":-1255000000.0,"rev_yoy":-247.4,"eps":-0.38,"eps_yoy":-8.6,"ni":-77055000.0,"ni_yoy":-6.0,"nm":6.1,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":639700000.0,"rev_yoy":-45.2,"eps":0.04,"eps_yoy":-69.2,"ni":6500000.0,"ni_yoy":-74.0,"nm":1.0,"derived":null,"fp":null},{"end":"2024-06-30","rev":614300000.0,"rev_yoy":-47.9,"eps":0.32,"eps_yoy":-45.8,"ni":62100000.0,"ni_yoy":-47.1,"nm":10.1,"derived":null,"fp":null},{"end":"2024-09-30","rev":452300000.0,"rev_yoy":-56.5,"eps":-0.01,"eps_yoy":-106.2,"ni":-3600000.0,"ni_yoy":-112.1,"nm":-0.8,"derived":null,"fp":null},{"end":"2024-12-31","rev":371400000.0,"rev_yoy":"turned +","eps":-8.23,"eps_yoy":-2065.8,"ni":-1512700000.0,"ni_yoy":-1863.1,"nm":-407.3,"derived":null,"fp":null},{"end":"2025-03-31","rev":629600000.0,"rev_yoy":-1.6,"eps":0.02,"eps_y