"tier":"high"},{"name":"Effort to rise","d":"2026-09-21","pol":1,"sig":1.2,"tier":"moderate"},{"name":"End of a rising market","d":"2026-09-30","pol":-1,"sig":1.3,"tier":"moderate"}],"asof":null},"scores":{"overall":40,"group":"SIC 48 Communications","group_rank":9,"group_n":34,"sector_rank":19,"sector_n":77,"earn":18}},"biz":{"name":"Warner Bros. Discovery, Inc.","desc":"Warner Bros. Discovery, Inc. operates as a media and entertainment company worldwide. It operates through three segments: Streaming, Studios, and Global Linear Networks. The Streaming segment offers streaming services, such as HBO Max and discovery+, and premium pay-TV services, including HBO and certain premium sports streaming products for mobile and connected TV devices. The Studios segment is involved in the production and release of feature films for initial exhibition in theaters, production and initial licensing of television programs to third parties and its networks/streaming services. This segment also distributes films and television programs to various third-party and internal television, streaming services, and physical and digital home entertainment markets; related consumer products and themed experience licensing; and publishes, develops, licenses, and distributes content for the interactive space in platforms, including console, handheld, mobile, and PC-based gaming for both internal and third-party game titles. The Global Linear Networks segment provides general and lifestyle entertainment networks, news networks; and hosts international media networks and global sports networks. In addition, the company offers a portfolio of content and products for television, film, streaming, interactive gaming, publishing, themed experiences, and consumer products under the Discovery Channel, HBO Max, CNN, DC Studios, TNT Sports, HBO, Food Network, TLC, TBS, Warner Bros. Motion Picture Group, Warner Bros. Television Group, Warner Bros. Games, Adult Swim, Turner Classic Movies, and other brands. Warner Bros. Discovery, Inc. was incorporated in 2008 and is headquartered in New York, New York.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"4841","sic_desc":"Cable & Other Pay Television Services","sector":"Communication Services","industry":"Entertainment","mcap":77595885568,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"NEW YORK, NY","exchange":"XNAS","fy_end":"1231","cik":1437107,"state_inc":"DE","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-06"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-06","q":[{"end":"2023-09-30","rev":9979000000.0,"rev_yoy":1.6,"eps":-0.17,"eps_yoy":82.1,"ni":-407000000.0,"ni_yoy":82.2,"nm":-4.1,"derived":null,"fp":null},{"end":"2023-12-31","rev":10284000000.0,"rev_yoy":-6.6,"eps":-0.16,"eps_yoy":80.5,"ni":-392000000.0,"ni_yoy":81.1,"nm":-3.8,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":9958000000.0,"rev_yoy":-6.9,"eps":-0.4,"eps_yoy":9.1,"ni":-955000000.0,"ni_yoy":9.9,"nm":-9.6,"derived":null,"fp":null},{"end":"2024-06-30","rev":9713000000.0,"rev_yoy":-6.2,"eps":-4.07,"eps_yoy":-698.0,"ni":-10028000000.0,"ni_yoy":-722.0,"nm":-103.2,"derived":null,"fp":null},{"end":"2024-09-30","rev":9623000000.0,"rev_yoy":-3.6,"eps":0.05,"eps_yoy":"turned +","ni":141000000.0,"ni_yoy":"turned +","nm":1.5,"derived":null,"fp":null},{"end":"2024-12-31","rev":10027000000.0,"rev_yoy":-2.5,"eps":-0.2,"eps_yoy":-25.0,"ni":-640000000.0,"ni_yoy":-63.3,"nm":-6.4,"derived":["eps","rev","ni"],"fp":null},{"end":"2025-03-31","rev":8979000000.0,"rev_yoy":-9.8,"eps":-0.18,"eps_yoy":55.0,"ni":-449000000.0,"ni_yoy":53.0,"nm":-5.0,"derived":null,"fp":null},{"end":"2025-06-30","rev":9812000000.0,"rev_yoy":1.0,"eps":0.63,"eps_yoy":"turned +","ni":1588000000.0,"ni_yoy":"turned +","nm":16.2,"derived":null,"fp":null},{"end":"2025-09-30","rev":9045000000.0,"rev_yoy":-6.0,"eps":-0.06,"eps_yoy":-220.0,"ni":-14