vices; and vehicle-to-everything (V2X) products and services to enhance road safety. The company's customers include OEMs and TNCs; OEMs and logistics platforms; and sensor and hardware component suppliers. Pony AI Inc. was incorporated in 2016 and is based in Guangzhou, the People's Republic of China.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"7373","sic_desc":"Services-Computer Integrated Systems Design","sector":"Technology","industry":"Information Technology Services","mcap":2641568000,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"GUANGZHOU, China","exchange":"XNAS","fy_end":"1231","cik":1969302,"state_inc":"E9","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"Yahoo quarterly income statement via yfinance (third-party fallback)","asof":"2026-10-03","q":[{"end":"2025-03-31","rev":null,"rev_yoy":null,"eps":null,"eps_yoy":null,"ni":null,"ni_yoy":null,"nm":null,"derived":null,"fp":null},{"end":"2025-06-30","rev":21455000.0,"rev_yoy":null,"eps":-0.14,"eps_yoy":null,"ni":-53098000.0,"ni_yoy":null,"nm":-247.5,"derived":null,"fp":null},{"end":"2025-09-30","rev":25442000.0,"rev_yoy":null,"eps":-0.16,"eps_yoy":null,"ni":-61315000.0,"ni_yoy":null,"nm":-241.0,"derived":null,"fp":null},{"end":"2025-12-31","rev":29125000.0,"rev_yoy":null,"eps":0.06,"eps_yoy":null,"ni":23432000.0,"ni_yoy":null,"nm":80.5,"derived":null,"fp":null},{"end":"2026-03-31","rev":34250000.0,"rev_yoy":null,"eps":-0.12,"eps_yoy":null,"ni":-50407000.0,"ni_yoy":null,"nm":-147.2,"derived":null,"fp":null},{"end":"2026-06-30","rev":36220000.0,"rev_yoy":68.8,"eps":-0.14,"eps_yoy":0.0,"ni":-59844000.0,"ni_yoy":-12.7,"nm":-165.2,"derived":null,"fp":null}],"a":[{"end":"2022-12-31","rev":68386000.0,"rev_yoy":null,"eps":-1.73,"eps_yoy":null,"ni":-148018000.0,"nm":-216.4},{"end":"2023-12-31","rev":71899000.0,"rev_yoy":5.14,"eps":-1.4,"eps_yoy":null,"ni":-124812000