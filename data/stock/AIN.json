lts; and engineered fabrics. Its AEC segment 3D-woven and injected composite components for aircraft engines composite airframe and engine components for military and commercial aircraft. The company sells its products to commercial and defense markets, space-launch vehicles and the emerging advanced air mobility market, as well as to customer end-users. Albany International Corp. was incorporated in 1895 and is headquartered in Portsmouth, New Hampshire.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"2221","sic_desc":"Broadwoven Fabric Mills, Man Made Fiber & Silk","sector":"Consumer Cyclical","industry":"Textile Manufacturing","mcap":1730072576,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"ROCHESTER, NH","exchange":"XNYS","fy_end":"1231","cik":819793,"state_inc":"DE","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-09-28","q":[{"end":"2023-09-30","rev":281106000.0,"rev_yoy":7.9,"eps":0.87,"eps_yoy":155.9,"ni":27109000.0,"ni_yoy":153.5,"nm":9.6,"derived":null,"fp":null},{"end":"2023-12-31","rev":323584000.0,"rev_yoy":20.4,"eps":0.97,"eps_yoy":67.2,"ni":30450000.0,"ni_yoy":68.0,"nm":9.4,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":313330000.0,"rev_yoy":16.4,"eps":0.87,"eps_yoy":1.2,"ni":27291000.0,"ni_yoy":1.5,"nm":8.7,"derived":null,"fp":null},{"end":"2024-06-30","rev":331994000.0,"rev_yoy":21.1,"eps":0.79,"eps_yoy":-7.1,"ni":24624000.0,"ni_yoy":-7.7,"nm":7.4,"derived":null,"fp":null},{"end":"2024-09-30","rev":298386000.0,"rev_yoy":6.1,"eps":0.57,"eps_yoy":-34.5,"ni":18029000.0,"ni_yoy":-33.5,"nm":6.0,"derived":null,"fp":null},{"end":"2024-12-31","rev":286905000.0,"rev_yoy":-11.3,"eps":0.57,"eps_yoy":-41.2,"ni":17679000.0,"ni_yoy":-41.9,"nm":6.2,"derived":["eps","rev","ni"],"fp":null},{"end":"2025-03-31","rev":288774000.0,"rev_yoy":-7.8,"eps":0.56,"eps_yo