low",false,"+24% vs low 9.22 (close)"],["Price within 25% of the 52-week high",true,"-20.9% vs high 14.40 (close)"],["RS rating 70 or higher (desk RS)",false,"RS 59"]],"tt_pass":false,"desk":{"movers":{"1d":{"side":"losers","rank":18,"chg":-6.1},"1w":{"side":"losers","rank":16,"chg":-15.44}},"movers_asof":"2026-10-09","scores":{"overall":36,"group":"SIC 35 Industrial Machinery & Computers","group_rank":26,"group_n":58,"sector_rank":211,"sector_n":518,"earn":23}},"biz":{"name":"CNH Industrial N.V.","desc":"CNH Industrial N.V., an equipment company, engages in the develops, manufacture, and sale agricultural and construction equipment in North America, Europe, the Middle East, Africa, South America, and the Asia Pacific. The company operates through three segments: Agriculture, Construction, and Financial Services. The Agriculture segment develops, manufactures, distributes, and supports agriculture equipment, implements, and precision agriculture solutions, such as tractors, harvesters, hay and forage equipment, seeding and planting equipment, and self-propelled sprayers under Case IH, New Holland, STEYR, and Raven brands. The Construction segment develops, manufactures, distributes, and supports construction equipment comprising excavators, crawler dozers, graders, wheel loaders, backhoe loaders, skid steer loaders, and compact track loaders under the New Holland Construction, Case Construction, and Eurocomach brands. The Financial Services segment provides and administers financing to end-use customers for the purchase of new and used agricultural and construction equipment and components, as well as revolving charge account financing and other financial services under the Banco CNH brand. This segment also offers wholesale financing to CNH dealers and distributors, as well as trade receivables factoring services. CNH Industrial N.V. was founded in 1842 and is headquartered in Basildon, the United Kingdom","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"3531","sic_desc":"Construction Machinery & Equip","sector":"Industrials","industry":"Farm & Heavy Construction Machinery","mcap":21661898752,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"BASILDON, ESSEX","exchange":"XNYS","fy_end":"1231","cik":1567094,"state_inc":"P7","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-10"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-03","q":[{"end":"2023-09-30","rev":5986000000.0,"rev_yoy":1.8,"eps":0.4,"eps_yoy":-2.4,"ni":537000000.0,"ni_yoy":-3.4,"nm":9.0,"derived":null,"fp":null},{"end":"2023-12-31","rev":6792000000.0,"rev_yoy":-2.2,"eps":0.44,"eps_yoy":2.3,"ni":582000000.0,"ni_yoy":-1.7,"nm":8.6,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":4818000000.0,"rev_yoy":-9.8,"eps":0.29,"eps_yoy":-17.1,"ni":368000000.0,"ni_yoy":-23.7,"nm":7.6,"derived":null,"fp":null},{"end":"2024-06-30","rev":5488000000.0,"rev_yoy":-16.4,"eps":0.32,"eps_yoy":-38.5,"ni":399000000.0,"ni_yoy":-43.5,"nm":7.3,"derived":null,"fp":null},{"end":"2024-09-30","rev":4654000000.0,"rev_yoy":-22.3,"eps":0.24,"eps_yoy":-40.0,"ni":306000000.0,"ni_yoy":-43.0,"nm":6.6,"derived":null,"fp":null},{"end":"2024-12-31","rev":4876000000.0,"rev_yoy":-28.2,"eps":0.14,"eps_yoy":-68.2,"ni":173000000.0,"ni_yoy":-70.3,"nm":3.5,"derived":["eps","rev","ni"],"fp":null},{"end":"2025-03-31","rev":3828000000.0,"rev_yoy":-20.5,"eps":0.1,"eps_yoy":-65.5,"ni":131000000.0,"ni_yoy":-64.4,"nm":3.4,"derived":null,"fp":null},{"end":"2025-06-30","rev":4711000000.0,"rev_yoy":-14.2,"eps":0.17,"eps_yoy":-46.9,"ni":213000000.0,"ni_yoy":-46.6,"nm":4.5,"derived":null,"fp":null},{"end":"2025-09-30","rev":4399000000.0,"rev_yoy":-5.5,"eps":0.06,"eps_yoy":-75.0,"ni":80000000.0,"ni_yoy":-73.9,"nm":1.8,"derived":null,"fp":null},{"end":"2025-12-31","rev":5157000000.0,"rev_yoy":5.8,"eps":0.07,"eps_yoy":-50.0,"ni":86000000.0,"ni_yoy":-50.3,"nm":1.7,"derived":["ep