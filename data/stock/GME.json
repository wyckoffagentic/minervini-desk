ies offering new and pre-owned gaming platforms from the console manufacturers, Software offering new and pre-owned gaming software for current and certain prior generation consoles and sell a wide range of in-game digital currency, digital downloadable content and full-game downloads, and Collectibles consist of apparel, toys, trading cards, gadgets and other retail products for pop culture and technology enthusiasts and collectibles related services, such as submission services for the authentication and grading of trading cards. The company operates its business in three geographic segments: the United States, Australia, and Europe.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"5734","sic_desc":"Retail-Computer & Computer Software Stores","sector":"Consumer Cyclical","industry":"Specialty Retail","mcap":12163518868.9,"mcap_src":"Massive ticker details (2026-10-03)","shares":504500990,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"GRAPEVINE, TX","website":"https://www.gamestop.com","employees":20000,"list_date":"2002-02-13","exchange":"XNYS","fy_end":"0130","cik":1326380,"state_inc":"DE","massive_asof":"2026-10-03","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-07","q":[{"end":"2023-10-28","rev":1078300000.0,"rev_yoy":-9.1,"eps":-0.01,"eps_yoy":96.8,"ni":-3100000.0,"ni_yoy":96.7,"nm":-0.3,"derived":null,"fp":null},{"end":"2024-02-03","rev":1793600000.0,"rev_yoy":-19.4,"eps":0.2,"eps_yoy":25.0,"ni":63400000.0,"ni_yoy":31.3,"nm":3.5,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-05-04","rev":881800000.0,"rev_yoy":-28.7,"eps":-0.11,"eps_yoy":35.3,"ni":-32300000.0,"ni_yoy":36.0,"nm":-3.7,"derived":null,"fp":null},{"end":"2024-08-03","rev":798300000.0,"rev_yoy":-31.4,"eps":0.04,"eps_yoy":"turned +","ni":14800000.0,"ni_yoy":"turned +","nm":1.9,"derived":null,"fp":null},{"end":"2024-11-02","rev":860300000.0,"rev_yoy":-20.2,"eps":0.04,"eps_yoy":"turned +","ni":174