g tower structures, rooftops and other structures that support antennas used for wireless communications. In our site leasing business, we lease space to wireless service providers and other customers on assets we own or operate, and manage rooftop and tower sites for property owners under various contractual arrangements. As of December 31, 2025, we owned 46,328 towers, a substantial portion of which were built by us or by other tower owners or operators who, like us, build towers to lease space to multiple wireless service providers. As of December 31, 2025, each of our towers had an average of 1.8 tenants. SBA Communications Corporation was established in 1989 and was incorporated in Florida.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"6798","sic_desc":"Real Estate Investment Trusts","sector":"Real Estate","industry":"REIT - Specialty","mcap":16813905920,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"BOCA RATON, FL","exchange":"XNAS","fy_end":"1231","cik":1034054,"state_inc":"FL","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-03","q":[{"end":"2023-09-30","rev":682544000.0,"rev_yoy":1.0,"eps":0.8,"eps_yoy":-12.1,"ni":87419000.0,"ni_yoy":-12.6,"nm":12.8,"derived":null,"fp":null},{"end":"2023-12-31","rev":675024000.0,"rev_yoy":-1.6,"eps":1.01,"eps_yoy":7.4,"ni":109528000.0,"ni_yoy":6.0,"nm":16.2,"derived":null,"fp":null},{"end":"2024-03-31","rev":657862000.0,"rev_yoy":-2.6,"eps":1.42,"eps_yoy":52.7,"ni":154543000.0,"ni_yoy":52.7,"nm":23.5,"derived":null,"fp":null},{"end":"2024-06-30","rev":660477000.0,"rev_yoy":-2.7,"eps":1.51,"eps_yoy":-19.3,"ni":162830000.0,"ni_yoy":-20.0,"nm":24.7,"derived":null,"fp":null},{"end":"2024-09-30","rev":667595000.0,"rev_yoy":-2.2,"eps":2.4,"eps_yoy":200.0,"ni":258534000.0,"ni_yoy":195.7,"nm":38.7,"derived":null,"fp":null},{"end":"2024-12-