 with Genmab to create Darzalex, which is regarded as the standard of care for multiple myeloma and is Genmab's leading product. Genmab also has Tepezza for thyroid eye disease (partnered with Horizon), Kesimpta for relapsing multiple sclerosis (partnered with Novartis), Rybrevant (partnered with Johnson & Johnson) for non-small cell lung cancer (NSCLC), Tivdak (partnered with Seagen) for cervical cancer, and Epkinly (partnered with AbbVie) for diffuse large B-cell lymphoma. Genmab has several pipeline candidates targeting other oncologic indications.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"2834","sic_desc":"Pharmaceutical Preparations","sector":"Healthcare","industry":"Biotechnology","mcap":21561222902.5,"mcap_src":"Massive ticker details (2026-10-03)","shares":624058550,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"1253 COPENHAGEN K, Denmark","website":"https://www.genmab.com","employees":3119,"list_date":"2010-10-05","exchange":"XNAS","cik":1434265,"massive_asof":"2026-10-03","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"Yahoo quarterly income statement via yfinance (third-party fallback)","asof":"2026-09-30","q":[{"end":"2025-03-31","rev":null,"rev_yoy":null,"eps":0.305,"eps_yoy":null,"ni":null,"ni_yoy":null,"nm":null,"derived":null,"fp":null},{"end":"2025-06-30","rev":925000000.0,"rev_yoy":null,"eps":0.542,"eps_yoy":null,"ni":336000000.0,"ni_yoy":null,"nm":36.3,"derived":null,"fp":null},{"end":"2025-09-30","rev":1022000000.0,"rev_yoy":null,"eps":0.646,"eps_yoy":null,"ni":401000000.0,"ni_yoy":null,"nm":39.2,"derived":null,"fp":null},{"end":"2025-12-31","rev":1058000000.0,"rev_yoy":null,"eps":null,"eps_yoy":null,"ni":31000000.0,"ni_yoy":null,"nm":2.9,"derived":null,"fp":null},{"end":"2026-03-31","rev":896000000.0,"rev_yoy":null,"eps":0.083,"eps_yoy":-72.8,"ni":53000000.0,"ni_yoy":null,"nm":5.9,"derived":null,"fp":null},{"end":"2026-06-30","rev":1155000000.0,"rev_yoy":24.9,"eps":0.491,"eps_yoy":-9.