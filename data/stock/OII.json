 business segments are Integrity Management and Digital Solutions, Subsea Robotics, Manufactured Products, Offshore Projects Group, and Aerospace and Defense Technologies. Maximum revenue is generated from its Subsea Robotics segment, which provides remotely operated vehicles (ROVs) for drill support and vessel-based services, underwater surveys, tooling, and other activities. Geographically, the company derives its key revenue from the United States, followed by Africa, Norway, Brazil, and other regions.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"1389","sic_desc":"Oil & Gas Field Services, NEC","sector":"Energy","industry":"Oil & Gas Equipment & Services","mcap":4475848135.65,"mcap_src":"Massive ticker details (2026-10-08)","shares":99529645,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"HOUSTON, TX","website":"https://www.oceaneering.com","employees":11100,"list_date":"1975-10-30","exchange":"XNYS","fy_end":"1231","cik":73756,"state_inc":"DE","massive_asof":"2026-10-08","sec_asof":"2026-10-08"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-06","q":[{"end":"2023-09-30","rev":635180000.0,"rev_yoy":13.5,"eps":0.29,"eps_yoy":61.1,"ni":29812000.0,"ni_yoy":62.9,"nm":4.7,"derived":null,"fp":null},{"end":"2023-12-31","rev":654629000.0,"rev_yoy":22.1,"eps":0.43,"eps_yoy":87.0,"ni":44529000.0,"ni_yoy":92.5,"nm":6.8,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":599092000.0,"rev_yoy":11.6,"eps":0.15,"eps_yoy":275.0,"ni":15135000.0,"ni_yoy":272.8,"nm":2.5,"derived":null,"fp":null},{"end":"2024-06-30","rev":668808000.0,"rev_yoy":11.9,"eps":0.34,"eps_yoy":78.9,"ni":34997000.0,"ni_yoy":84.2,"nm":5.2,"derived":null,"fp":null},{"end":"2024-09-30","rev":679811000.0,"rev_yoy":7.0,"eps":0.4,"eps_yoy":37.9,"ni":41237000.0,"ni_yoy":38.3,"nm":6.1,"derived":null,"fp":null},{"end":"2024-12-31","rev":713450000.0,"rev_yoy":9.0,"eps":0.55,"eps_yoy":27.9,"ni":56099000.0,"ni_yoy":26.0,"nm":7.9