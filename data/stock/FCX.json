ank":4,"group_n":21,"sector_rank":14,"sector_n":189,"earn":40}},"biz":{"name":"Freeport-McMoran Inc.","desc":"Freeport-McMoRan owns stakes in 10 copper mines, led by its 49% ownership of the Grasberg copper and gold operations in Indonesia, 55% of the Cerro Verde mine in Peru, and 72% of Morenci in Arizona. It sold around 1.1 million metric tons of copper (its share) in 2025, making it the one of the world's largest copper miners by volume. It also sold about 530,000 ounces of gold, mostly from Grasberg, and 74 million pounds of molybdenum. It had about 25 years of copper reserves at the end of December 2025. We expect it to sell about 1.3 million metric tons of copper and 610,000 ounces of gold midcycle in 2030.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"1000","sic_desc":"Metal Mining","sector":"Basic Materials","industry":"Copper","mcap":99487293993.44,"mcap_src":"Massive ticker details (2026-10-03)","shares":1436017523,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"PHOENIX, AZ","website":"https://www.fcx.com","employees":29000,"list_date":"1995-08-01","exchange":"XNYS","fy_end":"1231","cik":831259,"state_inc":"DE","massive_asof":"2026-10-03","sec_asof":"2026-10-09"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-06","q":[{"end":"2023-09-30","rev":5824000000.0,"rev_yoy":16.4,"eps":0.31,"eps_yoy":10.7,"ni":964000000.0,"ni_yoy":72.1,"nm":16.6,"derived":null,"fp":null},{"end":"2023-12-31","rev":5905000000.0,"rev_yoy":2.6,"eps":null,"eps_yoy":null,"ni":1007000000.0,"ni_yoy":3.1,"nm":17.1,"derived":["rev","ni"],"fp":null},{"end":"2024-03-31","rev":6321000000.0,"rev_yoy":17.3,"eps":0.32,"eps_yoy":-30.4,"ni":1162000000.0,"ni_yoy":10.8,"nm":18.4,"derived":null,"fp":null},{"end":"2024-06-30","rev":6624000000.0,"rev_yoy":15.5,"eps":0.42,"eps_yoy":82.6,"ni":1280000000.0,"ni_yoy":75.1,"nm":19.3,"derived":null,"fp":null},{"end":"2024-09-30","rev":6790000000.0,"rev_yoy":16.6,"eps":0.36,"eps_yoy":1