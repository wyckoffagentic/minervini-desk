iladelphia Flyers and the Xfinity Mobile Arena in Philadelphia, Pennsylvania; and Xumo. Comcast Corporation was founded in 1963 and is headquartered in Philadelphia, Pennsylvania.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"4841","sic_desc":"Cable & Other Pay Television Services","sector":"Communication Services","industry":"Telecom Services","mcap":74308452352,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"PHILADELPHIA, PA","exchange":"XNAS","fy_end":"1231","cik":1166691,"state_inc":"PA","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-08"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-08","q":[{"end":"2023-09-30","rev":30115000000.0,"rev_yoy":0.9,"eps":0.98,"eps_yoy":"turned +","ni":4046000000.0,"ni_yoy":"turned +","nm":13.4,"derived":null,"fp":null},{"end":"2023-12-31","rev":31253000000.0,"rev_yoy":2.3,"eps":0.81,"eps_yoy":17.4,"ni":3260000000.0,"ni_yoy":7.8,"nm":10.4,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":30058000000.0,"rev_yoy":1.2,"eps":0.97,"eps_yoy":6.6,"ni":3857000000.0,"ni_yoy":0.6,"nm":12.8,"derived":null,"fp":null},{"end":"2024-06-30","rev":29688000000.0,"rev_yoy":-2.7,"eps":1.0,"eps_yoy":-2.0,"ni":3929000000.0,"ni_yoy":-7.5,"nm":13.2,"derived":null,"fp":null},{"end":"2024-09-30","rev":32070000000.0,"rev_yoy":6.5,"eps":0.94,"eps_yoy":-4.1,"ni":3629000000.0,"ni_yoy":-10.3,"nm":11.3,"derived":null,"fp":null},{"end":"2024-12-31","rev":31914000000.0,"rev_yoy":2.1,"eps":1.24,"eps_yoy":53.1,"ni":4777000000.0,"ni_yoy":46.5,"nm":15.0,"derived":["eps","rev","ni"],"fp":null},{"end":"2025-03-31","rev":29887000000.0,"rev_yoy":-0.6,"eps":0.89,"eps_yoy":-8.2,"ni":3375000000.0,"ni_yoy":-12.5,"nm":11.3,"derived":null,"fp":null},{"end":"2025-06-30","rev":30313000000.0,"rev_yoy":2.1,"eps":2.98,"eps_yoy":198.0,"ni":11123000000.0,"ni_yoy":183.1,"nm":36.7,"derived":null,"fp":null},{"end":"2025-09-30","re