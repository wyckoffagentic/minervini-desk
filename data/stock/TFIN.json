uct, a digital bank account developed for Carriers, as well as provides service and performance scoring and benchmarking to the over-the-road trucking industry. The company was formerly known as Triumph Bancorp, Inc. and changed its name to Triumph Financial, Inc. in December 2022. Triumph Financial, Inc. was incorporated in 2003 and is headquartered in Dallas, Texas.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"6022","sic_desc":"State Commercial Banks","sector":"Financial Services","industry":"Banks - Regional","mcap":1485762304,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"DALLAS, TX","exchange":"XNYS","fy_end":"1231","cik":1539638,"state_inc":"TX","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-03","q":[{"end":"2023-09-30","rev":107533000.0,"rev_yoy":4.2,"eps":0.51,"eps_yoy":-17.7,"ni":11993000.0,"ni_yoy":-22.3,"nm":11.2,"derived":null,"fp":null},{"end":"2023-12-31","rev":108728000.0,"rev_yoy":2.3,"eps":0.38,"eps_yoy":-44.1,"ni":8825000.0,"ni_yoy":-47.3,"nm":8.1,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":101947000.0,"rev_yoy":1.3,"eps":0.14,"eps_yoy":-67.4,"ni":3357000.0,"ni_yoy":-67.1,"nm":3.3,"derived":null,"fp":null},{"end":"2024-06-30","rev":107015000.0,"rev_yoy":1.4,"eps":0.08,"eps_yoy":-72.4,"ni":1945000.0,"ni_yoy":-71.6,"nm":1.8,"derived":null,"fp":null},{"end":"2024-09-30","rev":108075000.0,"rev_yoy":0.5,"eps":0.19,"eps_yoy":-62.7,"ni":4546000.0,"ni_yoy":-62.1,"nm":4.2,"derived":null,"fp":null},{"end":"2024-12-31","rev":105478000.0,"rev_yoy":-3.0,"eps":0.12,"eps_yoy":-68.4,"ni":3036000.0,"ni_yoy":-65.6,"nm":2.9,"derived":["eps","rev","ni"],"fp":null},{"end":"2025-03-31","rev":102270000.0,"rev_yoy":0.3,"eps":-0.03,"eps_yoy":-121.4,"ni":-784000.0,"ni_yoy":-123.4,"nm":-0.8,"derived":null,"fp":null},{"end":"2025-06-30","rev":109201000.0,"rev