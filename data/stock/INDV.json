aceuticals Inc. The company was formerly known as Indivior PLC. and changed its name to Indivior Pharmaceuticals, Inc. in January 2026. Indivior Pharmaceuticals, Inc. was incorporated in 2014 and is headquartered in North Chesterfield, Virginia.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"2834","sic_desc":"Pharmaceutical Preparations","sector":"Healthcare","industry":"Drug Manufacturers - Specialty & Generic","mcap":4353017856,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"NORTH CHESTERFIELD, VA","exchange":"XNAS","fy_end":"1231","cik":1625297,"state_inc":"DE","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-09"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-08","q":[{"end":"2024-03-31","rev":284000000.0,"rev_yoy":null,"eps":0.45,"eps_yoy":null,"ni":61000000.0,"ni_yoy":null,"nm":21.5,"derived":null,"fp":null},{"end":"2024-06-30","rev":299000000.0,"rev_yoy":null,"eps":-0.72,"eps_yoy":null,"ni":-97000000.0,"ni_yoy":null,"nm":-32.4,"derived":null,"fp":null},{"end":"2024-09-30","rev":307000000.0,"rev_yoy":null,"eps":0.16,"eps_yoy":null,"ni":22000000.0,"ni_yoy":null,"nm":7.2,"derived":null,"fp":null},{"end":"2024-12-31","rev":299000000.0,"rev_yoy":null,"eps":0.16,"eps_yoy":null,"ni":21000000.0,"ni_yoy":null,"nm":7.0,"derived":["eps","rev"],"fp":null},{"end":"2025-03-31","rev":266000000.0,"rev_yoy":-6.3,"eps":0.38,"eps_yoy":-15.6,"ni":47000000.0,"ni_yoy":-23.0,"nm":17.7,"derived":null,"fp":null},{"end":"2025-06-30","rev":302000000.0,"rev_yoy":1.0,"eps":0.14,"eps_yoy":"turned +","ni":18000000.0,"ni_yoy":"turned +","nm":6.0,"derived":null,"fp":null},{"end":"2025-09-30","rev":314000000.0,"rev_yoy":2.3,"eps":0.33,"eps_yoy":106.2,"ni":42000000.0,"ni_yoy":90.9,"nm":13.4,"derived":null,"fp":null},{"end":"2025-12-31","rev":358000000.0,"rev_yoy":19.7,"eps":0.79,"eps_yoy":393.8,"ni":102000000.0,"ni_yoy":385.7,"nm":28.5,"derived":["eps","