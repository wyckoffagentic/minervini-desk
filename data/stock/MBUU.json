 market leader in performance sport boats, sold under its Malibu and Axis brands. It acquired Cobalt Boats, a producer of sterndrive boats, in 2017, and Pursuit Boats, which makes high-end offshore and outboard motorboats, in 2018. In 2021, it purchased Maverick Boat Group, a seller of flat fishing boats, with exposure to bay, dual console, and center console boats. Most recently, in 2026, it tied up with Saxdor Yachts, focused on adventure dayboats. Malibu has also expanded into boat trailers and accessories, and in 2020, began producing its own engines for its performance sport boats.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"3730","sic_desc":"Ship & Boat Building & Repairing","sector":"Consumer Cyclical","industry":"Recreational Vehicles","mcap":449244584.93999994,"mcap_src":"Massive ticker details (2026-10-03)","shares":19677818,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"LOUDON, TN","website":"https://www.malibuboats.com","employees":3000,"list_date":"2014-01-31","exchange":"XNAS","fy_end":"0630","cik":1590976,"state_inc":"DE","massive_asof":"2026-10-03","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-03","q":[{"end":"2023-09-30","rev":255830000.0,"rev_yoy":-15.3,"eps":0.98,"eps_yoy":-42.0,"ni":20770000.0,"ni_yoy":-42.5,"nm":8.1,"derived":null,"fp":null},{"end":"2023-12-31","rev":211074000.0,"rev_yoy":-37.7,"eps":0.49,"eps_yoy":-71.5,"ni":10144000.0,"ni_yoy":-72.1,"nm":4.8,"derived":null,"fp":null},{"end":"2024-03-31","rev":203419000.0,"rev_yoy":-45.8,"eps":-3.28,"eps_yoy":-230.7,"ni":-67759000.0,"ni_yoy":-226.8,"nm":-33.3,"derived":null,"fp":null},{"end":"2024-06-30","rev":158712000.0,"rev_yoy":-57.4,"eps":-0.95,"eps_yoy":-10.5,"ni":-19598000.0,"ni_yoy":-8.6,"nm":-12.3,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-09-30","rev":171580000.0,"rev_yoy":-32.9,"eps":-0.25,"eps_yoy":-125.5,"ni":-5147000.0,"ni_yoy":-124.8,"nm":-3.0,"derived":null,"fp":n