imited","desc":"Imperial Oil Ltd is an integrated oil company active in all phases of the petroleum industry in Canada, including the exploration for, and production and sale of, crude oil, natural gas, petroleum products, and petrochemicals. It also pursues lower-emission business opportunities, including carbon capture and storage, hydrogen, lower-emission fuels, and lithium. The company's reportable segments are Upstream, Downstream, and Chemical. Maximum revenue for the company is generated from its Downstream segment, which refines crude oil into petroleum products and distributes and market these products. The Upstream segment explores and produces crude oil, its equivalents, and natural gas, and the Chemical segment manufactures and markets hydrocarbon-based chemicals and chemical products.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"2911","sic_desc":"Petroleum Refining","sector":"Energy","industry":"Oil & Gas Integrated","mcap":57692610899.5,"mcap_src":"Massive ticker details (2026-10-09)","shares":481577721,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"CALGARY, Alberta, Canada","website":"https://www.imperialoil.ca","employees":5000,"list_date":"1986-07-16","exchange":"XASE","fy_end":"1231","cik":49938,"massive_asof":"2026-10-09","sec_asof":"2026-10-09"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-06","q":[{"end":"2023-09-30","rev":13920000000.0,"rev_yoy":-8.6,"eps":2.76,"eps_yoy":-14.8,"ni":1601000000.0,"ni_yoy":-21.2,"nm":11.5,"derived":null,"fp":null},{"end":"2023-12-31","rev":13109000000.0,"rev_yoy":-9.3,"eps":2.45,"eps_yoy":-14.3,"ni":1365000000.0,"ni_yoy":-21.0,"nm":10.4,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":12283000000.0,"rev_yoy":1.3,"eps":2.23,"eps_yoy":4.7,"ni":1195000000.0,"ni_yoy":-4.2,"nm":9.7,"derived":null,"fp":null},{"end":"2024-06-30","rev":13383000000.0,"rev_yoy":13.2,"eps":2.11,"eps_yoy":83.5,"ni":1133000000.0,"ni_yoy":67.9,"nm