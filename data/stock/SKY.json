 homes under the Champion Construction brand; operates a factory-direct manufactured home retail business under the Regional Homes, Titan Factory Direct, and Champion Homes Center brand names; and offers transportation services to manufactured housing and other industries. The company was formerly known as Skyline Champion Corporation and changed its name to Champion Homes, Inc. in August 2024. The company was founded in 2010 and is headquartered in Troy, Michigan.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"2451","sic_desc":"Mobile Homes","sector":"Consumer Cyclical","industry":"Residential Construction","mcap":4761453568,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"TROY, MI","exchange":"XNYS","fy_end":"0329","cik":90896,"state_inc":"IN","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-09-28","q":[{"end":"2023-09-30","rev":464236000.0,"rev_yoy":-42.5,"eps":0.8,"eps_yoy":-68.4,"ni":45669000.0,"ni_yoy":-68.3,"nm":9.8,"derived":null,"fp":null},{"end":"2023-12-30","rev":559455000.0,"rev_yoy":-3.9,"eps":0.81,"eps_yoy":-44.1,"ni":46970000.0,"ni_yoy":-43.3,"nm":8.4,"derived":null,"fp":null},{"end":"2024-03-30","rev":536363000.0,"rev_yoy":9.1,"eps":0.04,"eps_yoy":-96.0,"ni":2788000.0,"ni_yoy":-95.2,"nm":0.5,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-06-29","rev":627779000.0,"rev_yoy":35.1,"eps":0.79,"eps_yoy":-12.2,"ni":45794000.0,"ni_yoy":-10.7,"nm":7.3,"derived":null,"fp":null},{"end":"2024-09-28","rev":616877000.0,"rev_yoy":32.9,"eps":0.95,"eps_yoy":18.7,"ni":54734000.0,"ni_yoy":19.8,"nm":8.9,"derived":null,"fp":null},{"end":"2024-12-28","rev":644925000.0,"rev_yoy":15.3,"eps":1.07,"eps_yoy":32.1,"ni":61537000.0,"ni_yoy":31.0,"nm":9.5,"derived":null,"fp":null},{"end":"2025-03-29","rev":593867000.0,"rev_yoy":10.7,"eps":0.64,"eps_yoy":1500.0,"ni":36348000.0,"ni_yoy":120