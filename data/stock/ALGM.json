":59,"group":"SIC 367x (Electronics & Semis)","group_rank":79,"group_n":96,"sector_rank":291,"sector_n":394,"earn":71}},"biz":{"name":"Allegro MicroSystems, Inc. Common Stock","desc":"Allegro Microsystems Inc is a designer, developer, fabless manufacturer, and marketer of sensor ICs and application-specific analog power ICs for automotive and industrial markets. Its Sensor IC allows customers to precisely measure motion, speed, position, and current, and Power ICs include high-temperature and high-voltage capable motor drivers, power management, and LED driver ICs. Its products are divided into three categories: SENSE, which includes Current Sensors, Switches, and Latches, and Interface ICs among others; REGULATE, which includes Regulators, ClearPower Modules, and LED Drivers; and DRIVE, which includes BLDC Drivers, Brush DC, and others. Product-wise, the firm derives the majority of its revenue from sales of Magnetic sensors.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"3674","sic_desc":"Semiconductors & Related Devices","sector":"Technology","industry":"Semiconductors","mcap":6781306433.4800005,"mcap_src":"Massive ticker details (2026-10-03)","shares":186402046,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"MANCHESTER, NH","website":"https://www.allegromicro.com","employees":4250,"list_date":"2020-10-29","exchange":"XNAS","fy_end":"0331","cik":866291,"massive_asof":"2026-10-03","sec_asof":"2026-10-10"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-06","q":[{"end":"2023-09-29","rev":275509000.0,"rev_yoy":15.9,"eps":0.34,"eps_yoy":30.8,"ni":65617000.0,"ni_yoy":29.6,"nm":23.8,"derived":null,"fp":null},{"end":"2023-12-29","rev":254984000.0,"rev_yoy":2.5,"eps":0.17,"eps_yoy":-48.5,"ni":33345000.0,"ni_yoy":-48.3,"nm":13.1,"derived":null,"fp":null},{"end":"2024-03-29","rev":240581000.0,"rev_yoy":-10.7,"eps":-0.04,"eps_yoy":-112.5,"ni":-6924000.0,"ni_yoy":-111.2,"nm":-2.9,"derived":["eps","re