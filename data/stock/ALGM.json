rs; and DRIVE, which includes BLDC Drivers, Brush DC, and others. Product-wise, the firm derives the majority of its revenue from sales of Magnetic sensors.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"3674","sic_desc":"Semiconductors & Related Devices","sector":"Technology","industry":"Semiconductors","mcap":6781306433.4800005,"mcap_src":"Massive ticker details (2026-10-03)","shares":186402046,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"MANCHESTER, NH","website":"https://www.allegromicro.com","employees":4250,"list_date":"2020-10-29","exchange":"XNAS","fy_end":"0331","cik":866291,"massive_asof":"2026-10-03","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-09-29","q":[{"end":"2023-09-29","rev":275509000.0,"rev_yoy":15.9,"eps":0.34,"eps_yoy":30.8,"ni":65617000.0,"ni_yoy":29.6,"nm":23.8,"derived":null,"fp":null},{"end":"2023-12-29","rev":254984000.0,"rev_yoy":2.5,"eps":0.17,"eps_yoy":-48.5,"ni":33345000.0,"ni_yoy":-48.3,"nm":13.1,"derived":null,"fp":null},{"end":"2024-03-29","rev":240581000.0,"rev_yoy":-10.7,"eps":-0.04,"eps_yoy":-112.5,"ni":-6924000.0,"ni_yoy":-111.2,"nm":-2.9,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-06-28","rev":166919000.0,"rev_yoy":-40.0,"eps":-0.09,"eps_yoy":-129.0,"ni":-17675000.0,"ni_yoy":-129.0,"nm":-10.6,"derived":null,"fp":null},{"end":"2024-09-27","rev":187391000.0,"rev_yoy":-32.0,"eps":-0.18,"eps_yoy":-152.9,"ni":-33675000.0,"ni_yoy":-151.3,"nm":-18.0,"derived":null,"fp":null},{"end":"2024-12-27","rev":177872000.0,"rev_yoy":-30.2,"eps":-0.04,"eps_yoy":-123.5,"ni":-6860000.0,"ni_yoy":-120.6,"nm":-3.9,"derived":null,"fp":null},{"end":"2025-03-28","rev":192824000.0,"rev_yoy":-19.9,"eps":-0.08,"eps_yoy":-100.0,"ni":-14553000.0,"ni_yoy":-110.2,"nm":-7.5,"derived":["eps","ni"],"fp":null},{"end":"2025-06-27","rev":203405000.0,"rev_yoy":21.9,"eps":-0.07,"eps_yoy":22.2,"ni":-13227000.0,"ni_yoy":25.2,"nm":-6.5,"derived":null,"fp":null},