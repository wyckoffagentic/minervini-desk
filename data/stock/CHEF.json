e food products comprising cooking oils, butter, eggs, milk, and flour. The company serves menu-driven independent restaurants, fine dining establishments, country clubs, hotels, caterers, culinary schools, bakeries, patisseries, chocolatiers, cruise lines, casinos, and specialty food stores. It markets its center-of-the-plate products directly to consumers through a mail and e-commerce platform. The Chefs' Warehouse, Inc. was founded in 1985 and is headquartered in Ridgefield, Connecticut.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"5141","sic_desc":"Wholesale-Groceries, General Line","sector":"Consumer Defensive","industry":"Food Distribution","mcap":4498584064,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"RIDGEFIELD, CT","exchange":"XNAS","fy_end":"1226","cik":1517175,"state_inc":"DE","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-09-28","q":[{"end":"2023-06-30","rev":881820000.0,"rev_yoy":36.1,"eps":0.25,"eps_yoy":-40.5,"ni":9867000.0,"ni_yoy":-41.7,"nm":1.1,"derived":null,"fp":null},{"end":"2023-09-29","rev":881825000.0,"rev_yoy":33.2,"eps":0.19,"eps_yoy":-9.5,"ni":7322000.0,"ni_yoy":-11.5,"nm":0.8,"derived":null,"fp":null},{"end":"2023-12-29","rev":950473000.0,"rev_yoy":20.1,"eps":0.39,"eps_yoy":680.0,"ni":16000000.0,"ni_yoy":1264.0,"nm":1.7,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-29","rev":874488000.0,"rev_yoy":21.5,"eps":0.05,"eps_yoy":25.0,"ni":1931000.0,"ni_yoy":37.8,"nm":0.2,"derived":null,"fp":null},{"end":"2024-06-28","rev":954704000.0,"rev_yoy":8.3,"eps":0.37,"eps_yoy":48.0,"ni":15524000.0,"ni_yoy":57.3,"nm":1.6,"derived":null,"fp":null},{"end":"2024-09-27","rev":931452000.0,"rev_yoy":5.6,"eps":0.34,"eps_yoy":78.9,"ni":14098000.0,"ni_yoy":92.5,"nm":1.5,"derived":null,"fp":null},{"end":"2024-12-27","rev":1033568000.0,"rev_yoy":8.7,"eps":0.55,"