"sector_n":394,"earn":63}},"biz":{"name":"Allient Inc. Common Stock","desc":"Allient Inc, formerly Allied Motion Technologies Inc designs, manufactures, and sells precision and specialty controlled motion components and systems. The firm mainly caters to the Industrial, Vehicle, Aerospace & Defense, and Medical sectors. It mainly operates and sells across the United States, Canada, South America, Europe, and Asia. Its products and solutions include nano precision positioning systems, servo control systems, motion controllers, digital servo amplifiers and drives, brushless servo, torque, and coreless motors, brush motors, integrated motor drives, gear motors, gearing, incremental and absolute optical encoders, active (electronic) and passive (magnetic) filters for power quality and harmonic issues.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"3825","sic_desc":"Instruments For Meas & Testing of  Electricity & Elec Signals","sector":"Technology","industry":"Electronic Components","mcap":1971441150.45,"mcap_src":"Massive ticker details (2026-10-03)","shares":17002511,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"WILLIAMSVILLE, NY","website":"https://www.allient.com","employees":2478,"list_date":"1980-10-21","exchange":"XNAS","fy_end":"1231","cik":46129,"state_inc":"CO","massive_asof":"2026-10-03","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-06","q":[{"end":"2023-09-30","rev":145319000.0,"rev_yoy":8.1,"eps":0.41,"eps_yoy":0.0,"ni":6666000.0,"ni_yoy":0.9,"nm":4.6,"derived":null,"fp":null},{"end":"2023-12-31","rev":140997000.0,"rev_yoy":7.6,"eps":0.26,"eps_yoy":13.0,"ni":4347000.0,"ni_yoy":17.6,"nm":3.1,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":146713000.0,"rev_yoy":0.8,"eps":0.42,"eps_yoy":7.7,"ni":6902000.0,"ni_yoy":9.3,"nm":4.7,"derived":null,"fp":null},{"end":"2024-06-30","rev":136032000.0,"rev_yoy":-7.3,"eps":0.07,"eps_yoy":-83.3,"ni":115