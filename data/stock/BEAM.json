ch collaboration agreement with Pfizer Inc., focusing on in vivo base editing programs for targets rare genetic diseases of the liver, muscle, and central nervous system; Verve Therapeutics, Inc., for cardiovascular disease treatments; and Orbital Therapeutics to design RNA for the prevention, treatment, or diagnosis of human disease. Beam Therapeutics Inc. was incorporated in 2017 and is based in Cambridge, Massachusetts.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"2836","sic_desc":"Biological Products, (No Diagnostic Substances)","sector":"Healthcare","industry":"Biotechnology","mcap":2532613632,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"CAMBRIDGE, MA","exchange":"XNAS","fy_end":"1231","cik":1745999,"state_inc":"DE","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-09-30","q":[{"end":"2023-09-30","rev":17193000.0,"rev_yoy":8.8,"eps":-1.22,"eps_yoy":21.8,"ni":-96088000.0,"ni_yoy":12.3,"nm":-558.9,"derived":null,"fp":null},{"end":"2023-12-31","rev":316192000.0,"rev_yoy":1478.0,"eps":1.91,"eps_yoy":"turned +","ni":142797000.0,"ni_yoy":"turned +","nm":45.2,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":7410000.0,"rev_yoy":-69.4,"eps":-1.21,"eps_yoy":9.0,"ni":-98669000.0,"ni_yoy":-2.3,"nm":-1331.6,"derived":null,"fp":null},{"end":"2024-06-30","rev":11772000.0,"rev_yoy":-41.5,"eps":-1.11,"eps_yoy":-2.8,"ni":-91051000.0,"ni_yoy":-10.0,"nm":-773.5,"derived":null,"fp":null},{"end":"2024-09-30","rev":14269000.0,"rev_yoy":-17.0,"eps":-1.17,"eps_yoy":4.1,"ni":-96668000.0,"ni_yoy":-0.6,"nm":-677.5,"derived":null,"fp":null},{"end":"2024-12-31","rev":30067000.0,"rev_yoy":-90.5,"eps":-1.09,"eps_yoy":-157.1,"ni":-90354000.0,"ni_yoy":-163.3,"nm":-300.5,"derived":["eps","rev","ni"],"fp":null},{"end":"2025-03-31","rev":7470000.0,"rev_yoy":0.8,"eps":-1.23,"eps_yoy":-1.7,"