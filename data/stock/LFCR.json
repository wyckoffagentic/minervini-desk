velopment and validation, formulation development, sterile filtration, process scale-up, pilot studies, stability studies, process validation, and materials production for clinical studies. The company was formerly known as Landec Corporation and changed its name to Lifecore Biomedical, Inc. in November 2022. Lifecore Biomedical, Inc. was founded in 1965 and is headquartered in Chaska, Minnesota.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"2834","sic_desc":"Pharmaceutical Preparations","sector":"Healthcare","industry":"Drug Manufacturers - Specialty & Generic","mcap":247146128,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"CHASKA, MN","fy_end":"0525","cik":1005286,"state_inc":"DE","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-06"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-06","q":[{"end":"2023-05-28","rev":31145000.0,"rev_yoy":10.8,"eps":-1.32,"eps_yoy":29.8,"ni":-39321000.0,"ni_yoy":28.8,"nm":-126.3,"derived":["ni"],"fp":null},{"end":"2023-08-27","rev":24522000.0,"rev_yoy":3.4,"eps":-0.35,"eps_yoy":5.4,"ni":-10754000.0,"ni_yoy":1.9,"nm":-43.9,"derived":null,"fp":null},{"end":"2023-11-26","rev":30150000.0,"rev_yoy":37.9,"eps":0.39,"eps_yoy":"turned +","ni":14218000.0,"ni_yoy":"turned +","nm":47.2,"derived":null,"fp":null},{"end":"2024-02-25","rev":35704000.0,"rev_yoy":34.5,"eps":0.42,"eps_yoy":"turned +","ni":15632000.0,"ni_yoy":"turned +","nm":43.8,"derived":null,"fp":null},{"end":"2024-05-26","rev":37886000.0,"rev_yoy":21.6,"eps":-0.19,"eps_yoy":85.6,"ni":-7096000.0,"ni_yoy":82.0,"nm":-18.7,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-08-25","rev":24705000.0,"rev_yoy":0.7,"eps":-0.53,"eps_yoy":-51.4,"ni":-16230000.0,"ni_yoy":-50.9,"nm":-65.7,"derived":null,"fp":null},{"end":"2024-11-24","rev":32564000.0,"rev_yoy":8.0,"eps":-0.25,"eps_yoy":-164.1,"ni":-6571000.0,"ni_yoy":-146.2,"nm":-20.2,"derived":null,"f