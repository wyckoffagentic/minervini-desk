":"SIC 283x (Chemicals & Pharma)","group_rank":205,"group_n":239,"sector_rank":329,"sector_n":377,"earn":0}},"biz":{"name":"Mineralys Therapeutics, Inc. Common Stock","desc":"Mineralys Therapeutics Inc is a biopharmaceutical company focused on developing medicines to target diseases driven by dysregulated aldosterone. The Company's product candidate, lorundrostat, is a proprietary, orally administered, aldosterone synthase inhibitor that the Company is developing for the treatment of cardiorenal conditions affected by dysregulated aldosterone, including hypertension and related comorbidities, such as chronic kidney disease and obstructive sleep apnea. Its product candidate, lorundrostat, is a proprietary, orally administered, selective ASI that is designed to reduce aldosterone levels by inhibiting CYP11B2, the enzyme responsible for producing the hormone.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"2834","sic_desc":"Pharmaceutical Preparations","sector":"Healthcare","industry":"Biotechnology","mcap":2097011312.1999998,"mcap_src":"Massive ticker details (2026-10-03)","shares":88406885,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"RADNOR, PA","website":"https://mineralystx.com","employees":76,"list_date":"2023-02-10","exchange":"XNAS","fy_end":"1231","cik":1933414,"massive_asof":"2026-10-03","sec_asof":"2026-10-10"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-10","q":[{"end":"2023-09-30","rev":null,"rev_yoy":null,"eps":-0.57,"eps_yoy":55.8,"ni":-22760000.0,"ni_yoy":-240.8,"nm":null,"derived":null,"fp":null},{"end":"2023-12-31","rev":null,"rev_yoy":null,"eps":-0.63,"eps_yoy":64.0,"ni":-24389000.0,"ni_yoy":-168.8,"nm":null,"derived":["eps","ni"],"fp":null},{"end":"2024-03-31","rev":null,"rev_yoy":null,"eps":-0.7,"eps_yoy":-37.3,"ni":-31508000.0,"ni_yoy":-149.9,"nm":null,"derived":null,"fp":null},{"end":"2024-06-30","rev":null,"rev_yoy":null,"eps":-0.83,"eps_yoy":-167.7,"ni":-41014000.0