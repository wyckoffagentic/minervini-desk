"scores":{"overall":40,"group":"SIC 737x (Business Services & Software)","group_rank":211,"group_n":218,"sector_rank":385,"sector_n":394,"ai_tag":"networking","earn":17}},"biz":{"name":"VNET Group, Inc. American Depositary Shares","desc":"VNET started as AsiaCloud in 1999 and moved into the data center business, opening its first self-developed data center in 2010. The firm listed (as 21Vianet) on the Nasdaq in April 2011, subsequently changing its name to VNET Group in 2021. It originally focused on providing data center services such as colocation and cloud services to retail clients in China, but added hyperscale customers in 2019 and now counts large Chinese hyperscalers such as Alibaba Cloud, Tencent Cloud, and Huawei Cloud as customers. At the end of December 2025, it had 49,863 retail cabinets, with the majority in Beijing, Shanghai, and the Greater Bay area. It also had 889 MW of wholesale capacity in service, with a further 452 MW under construction and a further 840 MW held for future development.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"7370","sic_desc":"Services-Computer Programming, Data Processing, Etc.","sector":"Technology","industry":"Information Technology Services","mcap":1580038618.6499999,"mcap_src":"Massive ticker details (2026-10-03)","shares":279561356,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"Beijing, China","website":"https://www.vnet.com","employees":2581,"list_date":"2011-04-21","exchange":"XNAS","cik":1508475,"massive_asof":"2026-10-03","sec_asof":"2026-10-10"},"fin":{"available":true,"src":"Yahoo quarterly income statement via yfinance (third-party fallback)","asof":"2026-10-03","q":[{"end":"2025-06-30","rev":2434205000.0,"rev_yoy":null,"eps":-0.06,"eps_yoy":null,"ni":-11981000.0,"ni_yoy":null,"nm":-0.5,"derived":null,"fp":null},{"end":"2025-09-30","rev":2581747000.0,"rev_yoy":null,"eps":-1.14,"eps_yoy":null,"ni":-307066000.0,"ni_yoy":null,"nm":-11.9,"derived":null,"fp":null},{