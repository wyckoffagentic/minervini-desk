up and down bars (1.0x / 1.1x); latest 1 Oct: up bar on 0.99x volume, no VSA sign; balance strength 68/100.","status":null,"last_sign":null,"key_bars":[{"name":"No demand","d":"2026-08-17","pol":-1,"sig":0.83,"tier":"moderate"},{"name":"No demand","d":"2026-09-21","pol":-1,"sig":0.75,"tier":"moderate"},{"name":"Shakeout","d":"2026-09-22","pol":1,"sig":0.83,"tier":"moderate"}],"asof":null},"scores":{"overall":55,"group":"SIC 62 Brokers & Exchanges","group_rank":2,"group_n":8,"sector_rank":85,"sector_n":423,"earn":50}},"biz":{"name":"StoneX Group Inc.","desc":"StoneX Group Inc. operates as a global financial services network that connects companies, organizations, traders, and investors to a market ecosystem in the United States, Europe, South America, the Middle East, Asia, and internationally. The company operates through four segments: Commercial, Institutional, Self-Directed/Retail, and Payments. The Commercial segment provides risk management and hedging, voice brokerage, market intelligence, physical trading, and commodity financing, marketing, procurement, logistics, and price management services; and engages in the risk management and hedging services, execution and clearing of exchange-traded and OTC products. This segment also acts as an institutional dealer in fixed income securities to serve asset managers, commercial bank trust and investment departments, broker-dealers, and insurance companies; and engages in asset management business. The Self-Directed/Retail segment provides trading services and solutions in the global financial markets, including spot foreign exchange, precious metals trading, contracts for differences, and spread bets; and wealth management services, as well as offering physical gold and other precious metals in various forms and denominations through Stonexbullion.com. The company was formerly known as INTL FCStone Inc. and changed its name to StoneX Group Inc. in July 2020. StoneX Group Inc. was founded in 1924 and is headquartered in New York, New York.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"6200","sic_desc":"Security & Commodity Brokers, Dealers, Exchanges & Services","sector":"Financial Services","industry":"Capital Markets","mcap":7937786880,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"NEW YORK, NY","exchange":"XNAS","fy_end":"0930","cik":913760,"state_inc":"DE","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-03","q":[{"end":"2023-09-30","rev":16635600000.0,"rev_yoy":1.6,"eps":-0.91,"eps_yoy":-7.1,"ni":50700000.0,"ni_yoy":-3.1,"nm":0.3,"derived":["eps","rev","ni"],"fp":null},{"end":"2023-12-31","rev":19573000000.0,"rev_yoy":50.4,"eps":2.13,"eps_yoy":-11.6,"ni":69100000.0,"ni_yoy":-9.8,"nm":0.4,"derived":null,"fp":null},{"end":"2024-03-31","rev":22106100000.0,"rev_yoy":36.8,"eps":1.09,"eps_yoy":-16.2,"ni":53100000.0,"ni_yoy":27.3,"nm":0.2,"derived":null,"fp":null},{"end":"2024-06-30","rev":27069700000.0,"rev_yoy":79.9,"eps":1.25,"eps_yoy":-42.4,"ni":61900000.0,"ni_yoy":-10.9,"nm":0.2,"derived":null,"fp":null},{"end":"2024-09-30","rev":31139000000.0,"rev_yoy":87.2,"eps":1.55,"eps_yoy":"turned +","ni":76700000.0,"ni_yoy":51.3,"nm":0.2,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-12-31","rev":27935300000.0,"rev_yoy":42.7,"eps":1.69,"eps_yoy":-20.7,"ni":85100000.0,"ni_yoy":23.2,"nm":0.3,"derived":null,"fp":null},{"end":"2025-03-31","rev":36890700000.0,"rev_yoy":66.9,"eps":0.94,"eps_yoy":-13.8,"ni":71700000.0,"ni_yoy":35.0,"nm":0.2,"derived":null,"fp":null},{"end":"2025-06-30","rev":34828800000.0,"rev_yoy":28.7,"eps":0.54,"eps_yoy":-56.8,"ni":63400000.0,"ni_yoy":2.4,"nm":0.2,"derived":null,"fp":null},{"end":"2025-09-30","rev":32723400000.0,"rev_yoy":5.1,"eps":3.97,"eps_yoy":156.1,"ni":85700000.0,"ni_yoy":11.7,"nm":0.3,"derived":["eps","rev","ni"],"fp":null},{"end":"2025-12-31","rev":3