he company provides other operations, including timber and timberlands, as well as other minor products, services, and closed operations. The company sells its products primarily to retailers, wholesalers, home building, and industrial businesses in North America and South America. Louisiana-Pacific Corporation was incorporated in 1972 and is headquartered in Nashville, Tennessee.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"2400","sic_desc":"Lumber & Wood Products (No Furniture)","sector":"Industrials","industry":"Building Products & Equipment","mcap":4552013824,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"NASHVILLE, TN","exchange":"XNYS","fy_end":"1231","cik":60519,"state_inc":"DE","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-03","q":[{"end":"2023-09-30","rev":728000000.0,"rev_yoy":-14.6,"eps":1.63,"eps_yoy":-46.6,"ni":118000000.0,"ni_yoy":461.9,"nm":16.2,"derived":null,"fp":null},{"end":"2023-12-31","rev":658000000.0,"rev_yoy":-6.7,"eps":0.81,"eps_yoy":189.3,"ni":59000000.0,"ni_yoy":"turned +","nm":9.0,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":724000000.0,"rev_yoy":24.0,"eps":1.48,"eps_yoy":410.3,"ni":108000000.0,"ni_yoy":414.3,"nm":14.9,"derived":null,"fp":null},{"end":"2024-06-30","rev":814000000.0,"rev_yoy":33.2,"eps":2.23,"eps_yoy":"turned +","ni":160000000.0,"ni_yoy":"turned +","nm":19.7,"derived":null,"fp":null},{"end":"2024-09-30","rev":722000000.0,"rev_yoy":-0.8,"eps":1.28,"eps_yoy":-21.5,"ni":90000000.0,"ni_yoy":-23.7,"nm":12.5,"derived":null,"fp":null},{"end":"2024-12-31","rev":680000000.0,"rev_yoy":3.3,"eps":0.89,"eps_yoy":9.9,"ni":62000000.0,"ni_yoy":5.1,"nm":9.1,"derived":["eps","rev","ni"],"fp":null},{"end":"2025-03-31","rev":724000000.0,"rev_yoy":0.0,"eps":1.3,"eps_yoy":-12.2,"ni":91000000.0,"ni_yoy":-15.7,"nm":12.6,"derived"