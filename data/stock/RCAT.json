designed for extended-range intelligence, surveillance, and reconnaissance missions, such as THE EDGE 130. In addition, the company develops BLUE OPS, a battle-tested uncrewed surface vessel weapons system. Further, it provides FANG FPV DRONE, part of ARACHNID family of unmanned intelligence. The company has a Partnership with Havoc to develop open-architecture autonomous maritime defense systems. Red Cat Holdings, Inc. is based in South Salt Lake, Utah.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"7372","sic_desc":"Services-Prepackaged Software","sector":"Industrials","industry":"Aerospace & Defense","mcap":881161920,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"SOUTH SALT LAKE, UT","exchange":"XNAS","fy_end":"1231","cik":748268,"massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-10"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-10","q":[{"end":"2024-03-31","rev":6614029.0,"rev_yoy":null,"eps":-0.09,"eps_yoy":null,"ni":-6781080.0,"ni_yoy":null,"nm":-102.5,"derived":null,"fp":null},{"end":"2024-04-30","rev":6309070.0,"rev_yoy":"turned +","eps":null,"eps_yoy":null,"ni":-7072786.0,"ni_yoy":42.9,"nm":-112.1,"derived":["rev","ni"],"fp":null},{"end":"2024-06-30","rev":3210799.0,"rev_yoy":null,"eps":-0.11,"eps_yoy":null,"ni":-8160019.0,"ni_yoy":null,"nm":-254.1,"derived":null,"fp":null},{"end":"2024-07-31","rev":886440.0,"rev_yoy":185.1,"eps":null,"eps_yoy":null,"ni":-12416376.0,"ni_yoy":-112.7,"nm":-1400.7,"derived":null,"fp":null},{"end":"2024-09-30","rev":1292447.0,"rev_yoy":null,"eps":-0.16,"eps_yoy":null,"ni":-12433718.0,"ni_yoy":null,"nm":-962.0,"derived":null,"fp":null},{"end":"2024-10-31","rev":1534727.0,"rev_yoy":189.9,"eps":null,"eps_yoy":null,"ni":-13334618.0,"ni_yoy":-128.2,"nm":-868.9,"derived":null,"fp":null},{"end":"2025-03-31","rev":1630000.0,"rev_yoy":-75.4,"eps":-0.27,"eps_yoy":-200.0,"ni":-23123000.0,"ni_yoy":-