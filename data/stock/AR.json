ition, and some crude oil.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"1311","sic_desc":"Crude Petroleum & Natural Gas","sector":"Energy","industry":"Oil & Gas E&P","mcap":10462149170.0,"mcap_src":"Massive ticker details (2026-10-03)","shares":307439000,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"DENVER, CO","website":"https://www.anteroresources.com","employees":632,"list_date":"2013-10-10","exchange":"XNYS","fy_end":"1231","cik":1433270,"massive_asof":"2026-10-03","sec_asof":"2026-10-10"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-07","q":[{"end":"2023-09-30","rev":1126176000.0,"rev_yoy":-45.5,"eps":0.06,"eps_yoy":-96.5,"ni":32642000.0,"ni_yoy":-94.5,"nm":2.9,"derived":null,"fp":null},{"end":"2023-12-31","rev":1194143000.0,"rev_yoy":-42.7,"eps":0.16,"eps_yoy":-92.7,"ni":71418000.0,"ni_yoy":-90.7,"nm":6.0,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":1122271000.0,"rev_yoy":-20.3,"eps":0.07,"eps_yoy":-89.9,"ni":34672000.0,"ni_yoy":-86.7,"nm":3.1,"derived":null,"fp":null},{"end":"2024-06-30","rev":978654000.0,"rev_yoy":2.7,"eps":-0.26,"eps_yoy":7.1,"ni":-74598000.0,"ni_yoy":-9.8,"nm":-7.6,"derived":null,"fp":null},{"end":"2024-09-30","rev":1055920000.0,"rev_yoy":-6.2,"eps":-0.11,"eps_yoy":-283.3,"ni":-25190000.0,"ni_yoy":-177.2,"nm":-2.4,"derived":null,"fp":null},{"end":"2024-12-31","rev":1168751000.0,"rev_yoy":-2.1,"eps":0.48,"eps_yoy":200.0,"ni":158813000.0,"ni_yoy":122.4,"nm":13.6,"derived":["eps","rev","ni"],"fp":null},{"end":"2025-03-31","rev":1352707000.0,"rev_yoy":20.5,"eps":0.66,"eps_yoy":842.9,"ni":219466000.0,"ni_yoy":533.0,"nm":16.2,"derived":null,"fp":null},{"end":"2025-06-30","rev":1297493000.0,"rev_yoy":32.6,"eps":0.5,"eps_yoy":"turned +","ni":166573000.0,"ni_yoy":"turned +","nm":12.8,"derived":null,"fp":null},{"end":"2025-09-30","rev":1213994000.0,"rev_yoy":15.0,"eps":0.24,"eps_yoy":"turned +","ni":85610000.0,"ni_yoy":"turned +","nm":7.1,"derived