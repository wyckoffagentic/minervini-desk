 consumers through its direct-to-consumer business, which includes e-commerce websites and retail stores. Deckers Outdoor Corporation was founded in 1973 and is headquartered in Goleta, California.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"3021","sic_desc":"Rubber & Plastics Footwear","sector":"Consumer Cyclical","industry":"Footwear & Accessories","mcap":10774709248,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"GOLETA, CA","exchange":"XNYS","fy_end":"0331","cik":910521,"state_inc":"DE","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-03","q":[{"end":"2023-09-30","rev":1091907000.0,"rev_yoy":24.7,"eps":1.14,"eps_yoy":-70.0,"ni":178547000.0,"ni_yoy":75.9,"nm":16.4,"derived":null,"fp":null},{"end":"2023-12-31","rev":1560307000.0,"rev_yoy":16.0,"eps":2.52,"eps_yoy":-76.0,"ni":389919000.0,"ni_yoy":39.9,"nm":25.0,"derived":null,"fp":null},{"end":"2024-03-31","rev":959758000.0,"rev_yoy":21.2,"eps":4.95,"eps_yoy":43.1,"ni":127545000.0,"ni_yoy":39.0,"nm":13.3,"derived":null,"fp":null},{"end":"2024-06-30","rev":825347000.0,"rev_yoy":22.1,"eps":0.75,"eps_yoy":-68.9,"ni":115625000.0,"ni_yoy":81.9,"nm":14.0,"derived":null,"fp":null},{"end":"2024-09-30","rev":1311320000.0,"rev_yoy":20.1,"eps":1.59,"eps_yoy":39.5,"ni":242321000.0,"ni_yoy":35.7,"nm":18.5,"derived":null,"fp":null},{"end":"2024-12-31","rev":1827165000.0,"rev_yoy":17.1,"eps":3.0,"eps_yoy":19.0,"ni":456734000.0,"ni_yoy":17.1,"nm":25.0,"derived":null,"fp":null},{"end":"2025-03-31","rev":1021780000.0,"rev_yoy":6.5,"eps":1.0,"eps_yoy":-79.8,"ni":151411000.0,"ni_yoy":18.7,"nm":14.8,"derived":["eps","rev","ni"],"fp":null},{"end":"2025-06-30","rev":964538000.0,"rev_yoy":16.9,"eps":0.93,"eps_yoy":24.0,"ni":139203000.0,"ni_yoy":20.4,"nm":14.4,"derived":null,"fp":null},{"end":"2025-09-30","rev":1430840000.0,"rev_yoy":9.1,"eps":1.