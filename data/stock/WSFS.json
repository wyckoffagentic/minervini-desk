roducts, including noninterest-bearing demand deposits, money market, and interest-bearing demand deposits, as well as certificates of deposit and jumbo certificates of deposit. It also provides loans, such as commercial and industrial loans, commercial mortgage loans, and construction and land development loans, as well as residential and consumer loans comprising residential mortgage, equity secured lines and loans, installment loans, unsecured lines of credit, originated education loans, and previously acquired education loans. In addition, the company offers ATM vault cash, smart safe and cash logistics services, planning and advisory services, investment management, and personal and institutional trust services. WSFS Financial Corporation was founded in 1832 and is headquartered in Wilmington, Delaware.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"6021","sic_desc":"National Commercial Banks","sector":"Financial Services","industry":"Banks - Regional","mcap":4009805568,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"WILMINGTON, DE","exchange":"XNAS","fy_end":"1231","cik":828944,"state_inc":"DE","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-08"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-08","q":[{"end":"2023-09-30","rev":251139000.0,"rev_yoy":34.6,"eps":1.22,"eps_yoy":5.2,"ni":74166000.0,"ni_yoy":1.1,"nm":29.5,"derived":null,"fp":null},{"end":"2023-12-31","rev":257231000.0,"rev_yoy":20.7,"eps":1.06,"eps_yoy":-20.9,"ni":63908000.0,"ni_yoy":-24.3,"nm":24.8,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":261622000.0,"rev_yoy":15.6,"eps":1.09,"eps_yoy":7.9,"ni":65761000.0,"ni_yoy":5.4,"nm":25.1,"derived":null,"fp":null},{"end":"2024-06-30","rev":265237000.0,"rev_yoy":9.7,"eps":1.16,"eps_yoy":3.6,"ni":69273000.0,"ni_yoy":0.9,"nm":26.1,"derived":null,"fp":null},{"end":"2024-09-30","rev":273384000.0,"re