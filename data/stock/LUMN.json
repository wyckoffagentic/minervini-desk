so provides high speed and lower speed broadband service to residential and small business customers; local and long-distance voice services, professional services, and other ancillary services; and federal broadband and state support programs. It serves its products and services under the Lumen, CenturyLink, Black Lotus Labs, and Quantum Fiber brand name. The company was formerly known as CenturyLink, Inc. and changed its name to Lumen Technologies, Inc. in September 2020. Lumen Technologies, Inc. was incorporated in 1968 and is headquartered in Monroe, Louisiana.","desc_src":"Yahoo Finance profile via yfinance (third-party)","sic":"4813","sic_desc":"Telephone Communications (No Radiotelephone)","sector":"Communication Services","industry":"Telecom Services","mcap":5930810880,"mcap_src":"Yahoo Finance profile (third-party, cached)","hq":"MONROE, LA","exchange":"XNYS","fy_end":"1231","cik":18926,"state_inc":"LA","massive_note":"Massive ticker details not fetched yet (5 calls/min limit; filled in on a nightly run)","sec_asof":"2026-10-03"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-03","q":[{"end":"2023-09-30","rev":3641000000.0,"rev_yoy":-17.1,"eps":-0.08,"eps_yoy":-114.0,"ni":-78000000.0,"ni_yoy":-113.5,"nm":-2.1,"derived":null,"fp":null},{"end":"2023-12-31","rev":3517000000.0,"rev_yoy":-7.4,"eps":-2.03,"eps_yoy":33.2,"ni":-1995000000.0,"ni_yoy":35.0,"nm":-56.7,"derived":["eps","rev","ni"],"fp":null},{"end":"2024-03-31","rev":3290000000.0,"rev_yoy":-12.0,"eps":0.06,"eps_yoy":-88.5,"ni":57000000.0,"ni_yoy":-88.8,"nm":1.7,"derived":null,"fp":null},{"end":"2024-06-30","rev":3268000000.0,"rev_yoy":-10.7,"eps":-0.05,"eps_yoy":99.4,"ni":-49000000.0,"ni_yoy":99.4,"nm":-1.5,"derived":null,"fp":null},{"end":"2024-09-30","rev":3221000000.0,"rev_yoy":-11.5,"eps":-0.15,"eps_yoy":-87.5,"ni":-148000000.0,"ni_yoy":-89.7,"nm":-4.6,"derived":null,"fp":null},{"end":"2024-12-31","rev":3329000000.0,"rev_yoy":-5.3,"eps":0.08,"eps_yoy":"turned +","ni":85