,"biz":{"name":"Applied Industrial Technologies, Inc.","desc":"Applied Industrial Technologies Inc value-added distributor and technical solutions provider of industrial motion, fluid power, flow control, automation technologies and related maintenance supplies. It focus on industrial bearings, power transmission products, fluid power components and systems, specialty flow control, and factory automation solutions, as well as general maintenance products. Its customers use its products and services for both Maintenance, Repair, and Operations, Original Equipment Manufacturing, and new system install applications across a variety of end markets mainly in North America, as well as Australia, New Zealand, and Singapore. It segments are Service Center and Engineered Solutions. Majority of revenue is from Service Center. Majority of sales is from USA.","desc_src":"Massive (formerly Polygon.io) ticker details","sic":"5080","sic_desc":"Wholesale-Machinery, Equipment & Supplies","sector":"Industrials","industry":"Industrial Distribution","mcap":12672826436.050001,"mcap_src":"Massive ticker details (2026-10-08)","shares":36733895,"shares_src":"Massive ticker details (share-class shares outstanding)","hq":"CLEVELAND, OH","website":"https://www.applied.com","employees":6900,"list_date":"1972-06-01","exchange":"XNYS","fy_end":"0630","cik":109563,"state_inc":"OH","massive_asof":"2026-10-08","sec_asof":"2026-10-08"},"fin":{"available":true,"src":"SEC EDGAR XBRL companyfacts","asof":"2026-10-06","q":[{"end":"2023-09-30","rev":1095188000.0,"rev_yoy":3.1,"eps":2.39,"eps_yoy":21.3,"ni":93826000.0,"ni_yoy":22.0,"nm":8.6,"derived":null,"fp":null},{"end":"2023-12-31","rev":1077153000.0,"rev_yoy":1.6,"eps":2.32,"eps_yoy":13.2,"ni":91228000.0,"ni_yoy":13.4,"nm":8.5,"derived":null,"fp":null},{"end":"2024-03-31","rev":1146390000.0,"rev_yoy":1.3,"eps":2.48,"eps_yoy":0.4,"ni":97217000.0,"ni_yoy":0.0,"nm":8.5,"derived":null,"fp":null},{"end":"2024-06-30","rev":1160675000.0,"rev_yoy":0.2,"eps":